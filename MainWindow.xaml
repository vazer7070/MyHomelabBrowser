<Window x:Class="MyHomelabBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Browser"
        Height="850"
        Width="1400"
        Background="{StaticResource FluentBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <!-- TAB BAR -->
            <RowDefinition Height="48"/>
            <!-- ADDRESS BAR -->
            <RowDefinition Height="*"/>
            <!-- WEB -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- =========================
             TAB BAR (AU-DESSUS)
             ========================= -->
        <Grid Grid.Row="0"
              Grid.ColumnSpan="2"
              Height="44"
              Background="{StaticResource FluentSurface}"
              Panel.ZIndex="100">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="Tabs"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionChanged="Tabs_SelectionChanged">

                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <TabPanel IsItemsHost="True"
                                      Margin="6,6,0,6"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- STYLE + ANIMATIONS -->
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="MinWidth" Value="160"/>
                        <Setter Property="MaxWidth" Value="260"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="BorderThickness" Value="0"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd"
                                            Height="32"
                                            Background="#2A2A2A"
                                            CornerRadius="10"
                                            Margin="4,0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="Scale"/>
                                        </Border.RenderTransform>

                                        <ContentPresenter ContentSource="Header"
                                                          VerticalAlignment="Center"/>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="1.05"
                                                                         Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="1.05"
                                                                         Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="1"
                                                                         Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="1"
                                                                         Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#353535"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.ItemContainerStyle>
            </TabControl>

            <Button Grid.Column="1"
                    Content="＋"
                    Width="36"
                    Height="32"
                    Margin="6"
                    Click="NewTab_Click"/>
        </Grid>

        <!-- DOCK INDICATOR -->
        <Border x:Name="DockIndicator"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Height="44"
                Margin="10,4"
                Background="#30FFFFFF"
                BorderBrush="#80FFFFFF"
                BorderThickness="2"
                CornerRadius="8"
                Visibility="Collapsed"
                Panel.ZIndex="200"/>

        <!-- =========================
             ADDRESS BAR + COMMANDS
             ========================= -->
        <Grid Grid.Row="1"
              Grid.ColumnSpan="2"
              Height="48"
              Background="{StaticResource FluentSurface}"
              Panel.ZIndex="90">

            <Grid>
                <TextBox x:Name="AddressBar"
                         Margin="10,6"
                         Padding="12,5"
                         FontSize="14"
                         Background="#FF484444"
                         Foreground="White"
                         BorderThickness="0"
                         KeyDown="AddressBar_KeyDown"
                         PreviewMouseLeftButtonDown="AddressBar_PreviewMouseLeftButtonDown"
                         GotKeyboardFocus="AddressBar_GotKeyboardFocus"
                         GotFocus="AddressBar_GotFocus"
                         LostFocus="AddressBar_LostFocus"/>

                <!-- ✅ COMMAND SUGGESTIONS (RESTAURÉ) -->
                <Border x:Name="CommandSuggestions"
                        Margin="10,46,10,0"
                        Background="#1E1E1E"
                        BorderBrush="#444"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="Collapsed"
                        Panel.ZIndex="300"
                        VerticalAlignment="Top">

                    <ListBox x:Name="CommandList"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontSize="14"
                             MaxHeight="260"
                             SelectionChanged="CommandSuggestions_SelectionChanged"
                             KeyDown="CommandSuggestions_KeyDown">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text=":{Binding Key}"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Description}"
                                               Opacity="0.7"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>

        <!-- =========================
             WEB
             ========================= -->
        <ContentControl x:Name="WebHost"
                        Grid.Row="2"
                        Grid.Column="0"
                        Background="{StaticResource FluentBg}"
                        Panel.ZIndex="0"/>

        <!-- =========================
             SIDEBAR
             ========================= -->
        <Grid Grid.Row="2" Grid.Column="1" Panel.ZIndex="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ToggleSidebarBtn"
                    Grid.Column="0"
                    Content="❮"
                    Width="24"
                    Height="48"
                    Click="ToggleSidebar_Click"/>

            <Border x:Name="Sidebar"
                    Grid.Column="1"
                    Width="56"
                    Background="#1E1E1E">
                <StackPanel Margin="0,48,0,0">
                    <Button Content="⚙" Margin="6" Click="OpenSettings_Click"/>
                    <Button Content="🌐" Margin="6"/>
                    <Button Content="🔒" Margin="6"/>
                    <Button Content="📜" Margin="6"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
