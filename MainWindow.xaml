<Window x:Class="MyHomelabBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Browser"
        Height="850"
        Width="1400"
        Background="{StaticResource FluentBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <!-- tab bar -->
            <RowDefinition Height="48"/>
            <!-- address bar -->
            <RowDefinition Height="*"/>
            <!-- web content -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- =========================
             TAB BAR (ONGLETS + +)
             ========================= -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
              Background="{StaticResource FluentSurface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- TabControl = HEADERS ONLY -->
            <TabControl x:Name="Tabs"
                        Grid.Column="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0"
                        SelectionChanged="Tabs_SelectionChanged">

                <TabControl.Template>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <!-- SCROLL DES ONGLET -->
                            <ScrollViewer x:Name="TabScrollViewer"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="True"
                                          PanningMode="HorizontalOnly"
                                          Background="Transparent">

                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          Margin="6,6,0,6"
                                          Background="Transparent"/>
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- Style onglets (capsules) -->
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="MinWidth" Value="160"/>
                        <Setter Property="MaxWidth" Value="260"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd"
                                            Height="32"
                                            Background="#2A2A2A"
                                            CornerRadius="10"
                                            Margin="4,0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>

                                        <ContentPresenter ContentSource="Header"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Stretch"/>
                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <!-- ONGLET ACTIF -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="1.03"
                                                                         Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="1.03"
                                                                         Duration="0:0:0.15"/>
                                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                        To="#3A3A3A"
                                                                        Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>

                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="1"
                                                                         Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="1"
                                                                         Duration="0:0:0.15"/>
                                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                        To="#2A2A2A"
                                                                        Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>

                                        <!-- HOVER -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#353535"/>
                                        </Trigger>

                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.ItemContainerStyle>

            </TabControl>

            <!-- Bouton + -->
            <Button Grid.Column="1"
                    Content="＋"
                    Width="36"
                    Height="32"
                    Margin="6,6,10,6"
                    ToolTip="Nouvel onglet"
                    Click="NewTab_Click"/>
        </Grid>

        <!-- Dock Indicator -->
        <Border x:Name="DockIndicator"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Height="44"
                Margin="10,4"
                Background="#30FFFFFF"
                BorderBrush="#80FFFFFF"
                BorderThickness="2"
                CornerRadius="8"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="999"/>

        <!-- =========================
             ADDRESS BAR
             ========================= -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
              Background="{StaticResource FluentSurface}">
            <TextBox x:Name="AddressBar"
                     Margin="10,6"
                     Background="#FF484444"
                     Foreground="White"
                     BorderThickness="0"
                     Padding="12,5"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     KeyDown="AddressBar_KeyDown"
                     Text=""/>
        </Grid>

        <!-- =========================
             WEB CONTENT (TOUJOURS VISIBLE)
             ========================= -->
        <ContentControl x:Name="WebHost"
                        Grid.Row="2"
                        Grid.Column="0"
                        Background="{StaticResource FluentBg}"/>

        <!-- =========================
             SIDEBAR (RIGHT) + TOGGLE
             ========================= -->
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ToggleSidebarBtn"
                    Grid.Column="0"
                    Content="❮"
                    Width="24"
                    Height="48"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="ToggleSidebar_Click"/>

            <Border x:Name="Sidebar"
                    Grid.Column="1"
                    Width="56"
                    Background="#1E1E1E"
                    HorizontalAlignment="Right">
                <StackPanel Margin="0,48,0,0">
                    <Button Content="⚙" Margin="6"/>
                    <Button Content="🌐" Margin="6"/>
                    <Button Content="🔒" Margin="6"/>
                    <Button Content="📜" Margin="6"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
