<Window x:Class="MyHomelabBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:classes="clr-namespace:MyHomelabBrowser.classes"
        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
        Title="PommeBrowser"
        Icon="/Assets/PommeBrowser_desktop.ico"
        Height="860"
        Width="1400"
        MinWidth="720"
        MinHeight="460"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource TextFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Surcharges dynamiques : la barre active devient violette en navigation privée. -->
        <SolidColorBrush x:Key="SelectedTabBrush" Color="{StaticResource ToolbarColor}"/>
        <SolidColorBrush x:Key="AddressFieldBrush" Color="{StaticResource AddressBarColor}"/>

        <!-- Glyphe d'icône standard (police Segoe Fluent / MDL2). -->
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
        </Style>

        <!-- Pastille de compteur (téléchargements, blocages). -->
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SelectedTabBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,1,-1,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Bouton de la barre d'onglets (+ et onglet privé). -->
        <Style x:Key="TabStripButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <!-- Petit bouton d'action d'un téléchargement. -->
        <Style x:Key="DownloadActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <ContextMenu x:Key="ProfileContextMenu_LoggedOut">
            <MenuItem Header="Se connecter" Click="Profile_Login_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE77B;"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Créer un profil" Click="Profile_Create_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8FA;"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="ProfileContextMenu_LoggedIn">
            <MenuItem x:Name="ProfileHeaderItem" IsEnabled="False"/>
            <Separator/>
            <MenuItem Header="Changer de profil" x:Name="SwitchProfileMenu">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8AB;"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Paramètres du profil et coffre" Click="Profile_Settings_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8D7;"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Se déconnecter" Click="Profile_Logout_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7E8;"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="MainMenu">
            <MenuItem Header="Nouvel onglet" InputGestureText="Ctrl+T" Click="MainMenu_NewTab_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE710;"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Nouvel onglet privé" InputGestureText="Ctrl+Maj+N" Click="NewPrivateTab_Click">
                <MenuItem.Icon>
                    <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource PrivateIconGeometry}" Fill="{StaticResource TextSecondaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="ReopenClosedMenuItem" Header="Rouvrir l’onglet fermé" InputGestureText="Ctrl+Maj+T" Click="MainMenu_ReopenClosed_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7A7;"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem x:Name="FindMenuItem" Header="Rechercher dans la page…" InputGestureText="Ctrl+F" Click="MainMenu_Find_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE721;"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="ZoomMenuItem" Header="Zoom">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE71E;"/>
                </MenuItem.Icon>
                <MenuItem Header="Zoom avant" InputGestureText="Ctrl++" Click="MainMenu_ZoomIn_Click"/>
                <MenuItem Header="Zoom arrière" InputGestureText="Ctrl+-" Click="MainMenu_ZoomOut_Click"/>
                <MenuItem x:Name="ZoomResetMenuItem" Header="Taille réelle (100 %)" InputGestureText="Ctrl+0" Click="MainMenu_ZoomReset_Click"/>
            </MenuItem>
            <MenuItem x:Name="SplitViewMenuItem" Header="Vue côte à côte" Click="MainMenu_SplitView_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8A9;"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="WorkspacesMenuItem" Header="Espaces de travail">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8B7;"/>
                </MenuItem.Icon>
                <MenuItem Header="Enregistrer les onglets ouverts…"/>
            </MenuItem>
            <MenuItem x:Name="PrintMenuItem" Header="Imprimer…" InputGestureText="Ctrl+P" Click="MainMenu_Print_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE749;"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Historique" InputGestureText="Ctrl+H" Click="MainMenu_History_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE81C;"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Téléchargements" InputGestureText="Ctrl+J" Click="MainMenu_Downloads_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE896;"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Coffre des mots de passe" Click="Profile_Settings_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE72E;"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Ajouter la page aux services…" Click="MainMenu_AddService_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE968;"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Importer des favoris…" Click="MainMenu_ImportFavorites_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8B5;"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Effacer les données de navigation…" InputGestureText="Ctrl+Maj+Suppr" Click="MainMenu_ClearData_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Plein écran" InputGestureText="F11" Click="MainMenu_Fullscreen_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE740;"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Paramètres" InputGestureText="Ctrl+," Click="OpenSettings_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE713;"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Signaler un problème" Click="MainMenu_ReportIssue_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xEBE8;"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Diagnostic" Click="MainMenu_Diagnostics_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE9D9;"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem x:Name="VersionMenuItem" IsEnabled="False"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- =====================================================
             CHROME : onglets, navigation, favoris
             ===================================================== -->
        <StackPanel x:Name="BrowserChrome" Grid.Row="0">

            <!-- BARRE D'ONGLETS -->
            <Grid Height="40" Background="{StaticResource ChromeBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TabControl x:Name="Tabs"
                            Grid.Column="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="8,0,0,0"
                            SelectionChanged="Tabs_SelectionChanged">

                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="4,0,0,0">
                                    <Button Style="{StaticResource TabStripButtonStyle}"
                                            ToolTip="Nouvel onglet (Ctrl+T)"
                                            Click="NewTab_Click">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="13"/>
                                    </Button>
                                    <Button Style="{StaticResource TabStripButtonStyle}"
                                            ToolTip="Nouvel onglet privé (Ctrl+Maj+N)"
                                            Click="NewPrivateTab_Click">
                                        <Path Width="17" Height="17"
                                              Stretch="Uniform"
                                              Data="{StaticResource PrivateIconGeometry}"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                    </Button>
                                </StackPanel>
                                <controles:TabStripPanel IsItemsHost="True"
                                                         Margin="0,6,0,0"
                                                         ClipToBounds="True"/>
                            </DockPanel>
                        </ControlTemplate>
                    </TabControl.Template>

                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MaxWidth" Value="240"/>
                            <Setter Property="Height" Value="34"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Grid>
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    CornerRadius="10,10,0,0"
                                                    Margin="1,0,1,0"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter ContentSource="Header"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Fine séparation entre onglets inactifs -->
                                            <Border x:Name="Divider"
                                                    Width="1"
                                                    Height="16"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource BorderBrush}"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabHoverBrush}"/>
                                                <Setter TargetName="Divider" Property="Visibility" Value="Hidden"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedTabBrush}"/>
                                                <Setter TargetName="Divider" Property="Visibility" Value="Hidden"/>
                                                <Setter Property="Panel.ZIndex" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.ItemContainerStyle>
                </TabControl>

                <!-- Indicateur de réancrage d'une fenêtre détachée -->
                <Border x:Name="DockIndicator"
                        Grid.ColumnSpan="2"
                        Margin="8,4"
                        Background="#3058A6FF"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Panel.ZIndex="200"/>
            </Grid>

            <!-- BARRE DE NAVIGATION -->
            <Border x:Name="NavBar"
                    Height="46"
                    Background="{DynamicResource SelectedTabBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Précédent / Suivant / Actualiser -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackBtn"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                ToolTip="Précédent (Alt+←) — maintenir ou clic droit pour l’historique de l’onglet"
                                Click="BackBtn_Click"
                                PreviewMouseLeftButtonDown="BackBtn_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="BackBtn_PreviewMouseLeftButtonUp"
                                MouseRightButtonUp="BackBtn_MouseRightButtonUp">
                            <TextBlock Text="&#xE72B;" Style="{StaticResource IconGlyph}"/>
                        </Button>
                        <Button x:Name="ForwardBtn"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                Margin="2,0,0,0"
                                ToolTip="Suivant (Alt+→)"
                                Click="ForwardBtn_Click">
                            <TextBlock Text="&#xE72A;" Style="{StaticResource IconGlyph}"/>
                        </Button>
                        <Button x:Name="RefreshBtn"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                Margin="2,0,0,0"
                                ToolTip="Actualiser (F5)"
                                Click="RefreshBtn_Click">
                            <Grid>
                                <TextBlock x:Name="RefreshIcon" Text="&#xE72C;" Style="{StaticResource IconGlyph}"/>
                                <TextBlock x:Name="StopIcon" Text="&#xE711;" Style="{StaticResource IconGlyph}" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- BARRE D'ADRESSE -->
                    <Border x:Name="AddressBarBorder"
                            Grid.Column="1"
                            Height="34"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AddressFieldBrush}"
                            BorderThickness="1"
                            CornerRadius="17"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Indicateur de sécurité de la connexion -->
                            <Border x:Name="SecurityIndicator"
                                    Grid.Column="0"
                                    Width="30" Height="26"
                                    Margin="4,0,0,0"
                                    Background="Transparent"
                                    CornerRadius="13">
                                <Grid>
                                    <TextBlock x:Name="SecurityIconSecure" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"/>
                                    <TextBlock x:Name="SecurityIconInsecure" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"/>
                                    <TextBlock x:Name="SecurityIconLocal" Text="&#xE839;" FontFamily="{StaticResource IconFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" Visibility="Collapsed"/>
                                    <TextBlock x:Name="SecurityIconNeutral" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Pastille « Navigation privée » -->
                            <Border x:Name="PrivatePill"
                                    Grid.Column="1"
                                    Visibility="Collapsed"
                                    Background="{StaticResource PrivateSoftBrush}"
                                    CornerRadius="9"
                                    Padding="7,2,8,2"
                                    Margin="2,0,6,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="13" Height="13"
                                          Stretch="Uniform"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource PrivateIconGeometry}"
                                          Fill="{StaticResource PrivateBrush}"/>
                                    <TextBlock Text="Navigation privée"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource PrivateBrush}"/>
                                </StackPanel>
                            </Border>

                            <TextBox x:Name="AddressBar"
                                     Grid.Column="2"
                                     Style="{StaticResource AddressBarTextBoxStyle}"
                                     PreviewKeyDown="AddressBar_PreviewKeyDown"
                                     TextChanged="AddressBar_TextChanged"
                                     PreviewMouseLeftButtonDown="AddressBar_PreviewMouseLeftButtonDown"
                                     GotKeyboardFocus="AddressBar_GotKeyboardFocus"
                                     LostKeyboardFocus="AddressBar_LostKeyboardFocus"/>

                            <TextBlock Grid.Column="2"
                                       Text="Rechercher ou saisir une adresse"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13.5"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AddressBar}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Visible seulement quand le zoom de la page n'est pas à 100 % ; un clic le réinitialise. -->
                            <Button x:Name="ZoomButton"
                                    Grid.Column="3"
                                    Style="{StaticResource InlineIconButtonStyle}"
                                    Width="Auto"
                                    Padding="6,0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Visibility="Collapsed"
                                    Click="ZoomButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71E;" Style="{StaticResource IconGlyph}" FontSize="12"/>
                                    <TextBlock x:Name="ZoomButtonText" Margin="4,0,0,0" FontFamily="{StaticResource TextFont}" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="FillCredentialButton"
                                    Grid.Column="4"
                                    Style="{StaticResource InlineIconButtonStyle}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Click="FillCredential_Click"
                                    ToolTip="Remplir les identifiants enregistrés"
                                    IsEnabled="False">
                                <TextBlock Text="&#xE8D7;" Style="{StaticResource IconGlyph}" FontSize="13"/>
                            </Button>

                            <Button x:Name="FavoriteButton"
                                    Grid.Column="5"
                                    Style="{StaticResource InlineIconButtonStyle}"
                                    Margin="0,0,3,0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Click="ToggleFavoriteSafe_Click"
                                    ToolTip="Ajouter aux favoris (Ctrl+D)">
                                <Grid>
                                    <TextBlock x:Name="FavoriteIconEmpty" Text="&#xE734;" Style="{StaticResource IconGlyph}" FontSize="14"/>
                                    <TextBlock x:Name="FavoriteIconFilled" Text="&#xE735;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource WarningBrush}" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Modules et menus -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <Button x:Name="AdBlockButton"
                                Style="{StaticResource ToolbarModuleButtonStyle}"
                                ToolTip="Protection web"
                                Click="AdBlockButton_Click">
                            <Grid Width="34" Height="34">
                                <Path x:Name="AdBlockShieldPath"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Data="M12,2 L20,5 V11 C20,16.1 16.8,20.2 12,22 C7.2,20.2 4,16.1 4,11 V5 Z M12,5.1 L7,7 V11 C7,14.5 9,17.3 12,18.8 C15,17.3 17,14.5 17,11 V7 Z"/>
                                <Border x:Name="AdBlockBadge"
                                        Style="{StaticResource BadgeStyle}"
                                        Background="{StaticResource AccentStrongBrush}"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="AdBlockBadgeText" Style="{StaticResource BadgeTextStyle}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="ManualLegacyButton"
                                Style="{StaticResource ToolbarAmberButtonStyle}"
                                Margin="2,0,0,0"
                                Click="ManualLegacyButton_Click"
                                ToolTip="Ouvrir ce site avec Flash Legacy (Basilisk)">
                            <TextBlock Text="&#xE945;" Style="{StaticResource IconGlyph}"/>
                        </Button>

                        <Button x:Name="DownloadsBtn"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                Margin="2,0,0,0"
                                ToolTip="Téléchargements (Ctrl+J)"
                                Click="DownloadsBtn_Click">
                            <Grid Width="34" Height="34">
                                <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}"/>
                                <Border x:Name="DownloadsBadge"
                                        Style="{StaticResource BadgeStyle}"
                                        Background="{StaticResource SuccessBrush}"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="DownloadsBadgeText" Style="{StaticResource BadgeTextStyle}" Foreground="#0B2A1B"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Border Width="1" Height="20" Margin="8,0" Background="{StaticResource BorderBrush}"/>

                        <Button x:Name="ProfileButton"
                                Width="30" Height="30"
                                MinHeight="0"
                                Padding="0"
                                Cursor="Hand"
                                Focusable="False"
                                Click="ProfileButton_Click"
                                ToolTip="Profil utilisateur"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                FontWeight="SemiBold"
                                FontSize="13">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse Fill="{TemplateBinding Background}"/>
                                        <Ellipse x:Name="Ring" Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="1"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="MainMenuButton"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                Margin="4,0,0,0"
                                ToolTip="Menu"
                                Click="MainMenuButton_Click">
                            <TextBlock Text="&#xE712;" Style="{StaticResource IconGlyph}"/>
                        </Button>
                    </StackPanel>

                    <!-- POPUP : protection web -->
                    <Popup x:Name="AdBlockPopup"
                           PlacementTarget="{Binding ElementName=AdBlockButton}"
                           Placement="Bottom"
                           HorizontalOffset="-330"
                           VerticalOffset="6"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Margin="10" Background="Transparent" Effect="{StaticResource PopupShadow}">
                            <ContentControl x:Name="AdBlockPanelHost"/>
                        </Border>
                    </Popup>

                    <!-- POPUP : téléchargements -->
                    <Popup x:Name="DownloadsPopup"
                           PlacementTarget="{Binding ElementName=DownloadsBtn}"
                           Placement="Bottom"
                           HorizontalOffset="-340"
                           VerticalOffset="6"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Width="400"
                                Margin="10"
                                Padding="14,12"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Effect="{StaticResource PopupShadow}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource TextButtonStyle}"
                                            Content="Effacer la liste"
                                            FontSize="12"
                                            Click="ClearCompletedDownloads"/>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource TextButtonStyle}"
                                            Content="Ouvrir le dossier"
                                            FontSize="12"
                                            Click="OpenDownloadsFolder_Click"/>
                                    <TextBlock Text="Téléchargements"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </DockPanel>

                                <TextBlock x:Name="DownloadsEmptyText"
                                           Text="Aucun téléchargement pour le moment."
                                           Margin="0,6,0,10"
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextTertiaryBrush}"/>

                                <ListBox x:Name="DownloadsList"
                                         ItemsSource="{Binding Source={x:Static classes:DownloadManager.Instance}, Path=Items}"
                                         MaxHeight="380"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,6"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,10"
                                                    Background="{StaticResource SurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="32" Height="32"
                                                            CornerRadius="8"
                                                            Background="{StaticResource AccentSoftBrush}"
                                                            VerticalAlignment="Top"
                                                            Margin="0,0,10,0">
                                                        <TextBlock Text="&#xE8A5;"
                                                                   FontFamily="{StaticResource IconFont}"
                                                                   FontSize="15"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding ResultFilePath}"
                                                                   Cursor="Hand"
                                                                   MouseLeftButtonUp="DownloadItem_Open"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding SizeText}"
                                                                       FontSize="11.5"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text=" · " FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}"/>
                                                            <TextBlock FontSize="11.5">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding StatusText}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                <Setter Property="Text" Value="{Binding SpeedText}"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <ProgressBar Margin="0,7,0,0"
                                                                     Minimum="0"
                                                                     Maximum="1"
                                                                     Value="{Binding Progress01, Mode=OneWay}"
                                                                     Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Top"
                                                                Margin="8,0,0,0">
                                                        <Button Style="{StaticResource DownloadActionButtonStyle}"
                                                                ToolTip="Pause"
                                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                                                Click="DownloadItem_Pause">
                                                            <TextBlock Text="&#xE769;" Style="{StaticResource IconGlyph}" FontSize="12"/>
                                                        </Button>
                                                        <Button Style="{StaticResource DownloadActionButtonStyle}"
                                                                ToolTip="Reprendre"
                                                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}"
                                                                Click="DownloadItem_ResumeOrRetry">
                                                            <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}" FontSize="12"/>
                                                        </Button>
                                                        <Button Style="{StaticResource DownloadActionButtonStyle}"
                                                                ToolTip="Réessayer"
                                                                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}"
                                                                Click="DownloadItem_ResumeOrRetry">
                                                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="12"/>
                                                        </Button>
                                                        <Button Style="{StaticResource DownloadActionButtonStyle}"
                                                                ToolTip="Annuler"
                                                                Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVisibility}}"
                                                                Click="DownloadItem_Cancel">
                                                            <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="12"/>
                                                        </Button>
                                                        <Button Style="{StaticResource DownloadActionButtonStyle}"
                                                                ToolTip="Afficher dans le dossier"
                                                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}"
                                                                Click="DownloadItem_OpenFolder">
                                                            <TextBlock Text="&#xE838;" Style="{StaticResource IconGlyph}" FontSize="12"/>
                                                        </Button>
                                                        <Button Style="{StaticResource DownloadActionButtonStyle}"
                                                                ToolTip="Retirer de la liste"
                                                                Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}"
                                                                Click="DownloadItem_Remove">
                                                            <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}" FontSize="12"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- POPUP : suggestions de l'omnibox -->
                    <Popup x:Name="CommandSuggestionsPopup"
                           PlacementTarget="{Binding ElementName=AddressBarBorder}"
                           Placement="Bottom"
                           VerticalOffset="4"
                           StaysOpen="True"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="None">
                        <Border Width="{Binding ActualWidth, ElementName=AddressBarBorder}"
                                Margin="0,0,10,10"
                                Padding="5"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Effect="{StaticResource PopupShadow}">
                            <ListBox x:Name="CommandList"
                                     Focusable="False"
                                     MaxHeight="360"
                                     FontSize="13"
                                     PreviewMouseLeftButtonUp="CommandList_PreviewMouseLeftButtonUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Primary}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Secondary}"
                                                           Margin="0,1,0,0"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- BARRE DE FAVORIS (masquée s'il n'y a aucun favori) -->
            <Border x:Name="FavoritesBarHost"
                    Height="32"
                    Background="{DynamicResource SelectedTabBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                <StackPanel x:Name="FavoritesBar"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            ClipToBounds="True"
                            Margin="8,0"/>
            </Border>
        </StackPanel>

        <!-- =====================================================
             CONTENU
             ===================================================== -->
        <ContentControl x:Name="WebHost"
                        Grid.Row="1"
                        Focusable="False"
                        Background="{StaticResource WindowBackgroundBrush}"/>

        <!-- Recherche dans la page (Ctrl+F) : Popup, pour rester au-dessus du WebView2. -->
        <Popup x:Name="FindPopup"
               Grid.Row="1"
               PlacementTarget="{Binding ElementName=WebHost}"
               Placement="Custom"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="None">
            <Border Margin="0,8,16,16"
                    Padding="10,6,6,6"
                    CornerRadius="10"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource PopupShadow}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Margin="0,0,8,0"/>
                    <Grid Width="220" VerticalAlignment="Center">
                        <TextBox x:Name="FindBox"
                                 Style="{StaticResource AddressBarTextBoxStyle}"
                                 FontSize="13"
                                 Padding="0"
                                 TextChanged="FindBox_TextChanged"
                                 PreviewKeyDown="FindBox_PreviewKeyDown"/>
                        <TextBlock Text="Rechercher dans la page"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontSize="13"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FindBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="FindCountText"
                               MinWidth="64"
                               Margin="8,0"
                               FontSize="12"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Border Width="1" Margin="2,4,6,4" Background="{StaticResource BorderBrush}"/>
                    <CheckBox x:Name="FindCaseToggle"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0"
                              ToolTip="Respecter la casse"
                              Checked="FindOptions_Changed"
                              Unchecked="FindOptions_Changed">
                        <TextBlock Text="Aa" FontSize="12"/>
                    </CheckBox>
                    <Button Style="{StaticResource InlineIconButtonStyle}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            ToolTip="Précédent (Maj+Entrée)"
                            Click="FindPrevious_Click">
                        <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource InlineIconButtonStyle}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            ToolTip="Suivant (Entrée)"
                            Click="FindNext_Click">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource InlineIconButtonStyle}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            ToolTip="Fermer (Échap)"
                            Click="FindClose_Click">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Notifications : Popup pour rester visibles au-dessus du WebView2 (fenêtre native). -->
        <Popup x:Name="ToastPopup"
               Grid.Row="1"
               PlacementTarget="{Binding ElementName=WebHost}"
               Placement="Custom"
               AllowsTransparency="True"
               Focusable="False"
               StaysOpen="True"
               PopupAnimation="None">
            <ItemsControl x:Name="ToastHost" Width="360" Margin="0,0,8,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type classes:ToastItem}">
                        <Border Margin="0,8,0,0"
                                Padding="14,12,10,12"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Effect="{StaticResource PopupShadow}"
                                Loaded="ToastCard_Loaded">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="KindIcon"
                                           Text="&#xE946;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="16"
                                           Margin="0,1,12,0"
                                           VerticalAlignment="Top"
                                           Foreground="{StaticResource AccentBrush}"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Message}"
                                               Margin="0,3,0,0"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="34"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="{Binding ActionLabel}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Left"
                                            MinHeight="28"
                                            Padding="12,4"
                                            FontSize="12"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"
                                            Click="ToastAction_Click"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Style="{StaticResource InlineIconButtonStyle}"
                                        Width="24" Height="24"
                                        VerticalAlignment="Top"
                                        Margin="6,-4,0,0"
                                        ToolTip="Fermer"
                                        Click="ToastClose_Click">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="10"/>
                                </Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static classes:ToastKind.Success}">
                                <Setter TargetName="KindIcon" Property="Text" Value="&#xE73E;"/>
                                <Setter TargetName="KindIcon" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static classes:ToastKind.Warning}">
                                <Setter TargetName="KindIcon" Property="Text" Value="&#xE7BA;"/>
                                <Setter TargetName="KindIcon" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Popup>
    </Grid>
</Window>
