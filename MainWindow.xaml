<Window x:Class="MyHomelabBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Browser"
        Height="850"
        Width="1400"
        Background="{StaticResource FluentBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <!-- TAB BAR -->
            <RowDefinition Height="48"/>
            <!-- ADDRESS BAR -->
            <RowDefinition Height="32"/>
            <!-- FAVORITES BAR -->
            <RowDefinition Height="*"/>
            <!-- WEB -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- =========================
             TAB BAR
             ========================= -->
        <Grid Grid.Row="0"
              Grid.ColumnSpan="2"
              Height="44"
              Background="{StaticResource FluentSurface}"
              Panel.ZIndex="100">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="Tabs"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionChanged="Tabs_SelectionChanged">

                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <TabPanel IsItemsHost="True"
                                      Margin="6,6,0,6"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </TabControl.Template>

                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="MinWidth" Value="160"/>
                        <Setter Property="MaxWidth" Value="260"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="BorderThickness" Value="0"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd"
                                            Height="32"
                                            Background="#2A2A2A"
                                            CornerRadius="10"
                                            Margin="4,0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="Scale"/>
                                        </Border.RenderTransform>

                                        <ContentPresenter ContentSource="Header"
                                                          VerticalAlignment="Center"/>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="1.05"
                                                                         Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="1.05"
                                                                         Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="1"
                                                                         Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="Scale"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="1"
                                                                         Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd"
                                                    Property="Background"
                                                    Value="#353535"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.ItemContainerStyle>
            </TabControl>

            <!-- + / PRIVATE BUTTONS + PRIVATE INDICATOR -->
            <Grid Grid.Column="1"
      Margin="6"
      VerticalAlignment="Center">

                <!-- BOUTONS (layout normal, inchangé) -->
                <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center">

                    <Button Content="＋"
                Width="36"
                Height="32"
                Margin="0,0,4,0"
                ToolTip="Nouvel onglet"
                Click="NewTab_Click"/>

                    <Button Content="🕶️"
                Width="36"
                Height="32"
                ToolTip="Nouvel onglet privé"
                Click="NewPrivateTab_Click"/>
                </StackPanel>

                <!-- INDICATEUR PRIVÉ (OVERLAY ABSOLU) -->
                <Border x:Name="PrivateIndicator"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="-150,0,0,0"
            Height="28"
            Padding="10,2"
            Background="#402B1457"
            CornerRadius="14"
            Visibility="Collapsed"
            IsHitTestVisible="False">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🕶️"
                       Margin="0,0,6,0"
                       Foreground="#C084FC"/>
                        <TextBlock Text="Navigation privée"
                       Foreground="#C084FC"
                       FontWeight="SemiBold"
                       FontSize="12"/>
                    </StackPanel>
                </Border>

            </Grid>



        </Grid>

        <!-- =========================
             DOCK INDICATOR
             ========================= -->
        <Border x:Name="DockIndicator"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Height="44"
                Margin="10,4"
                Background="#30FFFFFF"
                BorderBrush="#80FFFFFF"
                BorderThickness="2"
                CornerRadius="8"
                Visibility="Collapsed"
                Panel.ZIndex="200"/>

        <!-- =========================
     ADDRESS BAR
     ========================= -->
        <Grid Grid.Row="1"
      Grid.ColumnSpan="2"
      Height="48"
      Background="{StaticResource FluentSurface}"
      Panel.ZIndex="90">

            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>

                <!-- ZONE ADRESSE -->
                <Grid Grid.Column="0">

                    <TextBox x:Name="AddressBar"
                     Padding="12,5"
                     FontSize="14"
                     Background="#FF484444"
                     Foreground="White"
                     BorderThickness="0"
                     KeyDown="AddressBar_KeyDown"
                     PreviewMouseLeftButtonDown="AddressBar_PreviewMouseLeftButtonDown"
                     GotKeyboardFocus="AddressBar_GotKeyboardFocus"
                     GotFocus="AddressBar_GotFocus"
                     LostFocus="AddressBar_LostFocus"/>

                   
                </Grid>

                <!-- BOUTON FAVORI (ZONE DÉDIÉE, JAMAIS RECOUVERTE) -->
                <Button x:Name="FavoriteButton"
                Grid.Column="1"
                Content="★"
                Width="28"
                Height="28"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Click="ToggleFavorite_Click"
                Foreground="Gray"
                Cursor="Hand"/>

                <!-- COMMANDES / HISTORIQUE -->
                <Popup x:Name="CommandSuggestionsPopup"
               PlacementTarget="{Binding ElementName=AddressBar}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               Focusable="False"
               PopupAnimation="Fade">

                    <Border Margin="0,6,0,0"
                    Background="#1E1E1E"
                    BorderBrush="#444"
                    BorderThickness="1"
                    CornerRadius="12">

                        <ListBox x:Name="CommandList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         FontSize="14"
                         MaxHeight="260"
                         SelectionChanged="CommandSuggestions_SelectionChanged"
                         KeyDown="CommandSuggestions_KeyDown"/>

                    </Border>
                </Popup>
            </Grid>
        </Grid>



        <!-- =========================
             FAVORITES BAR
             ========================= -->
        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Background="#1E1E1E"
                BorderBrush="#2A2A2A"
                BorderThickness="0,1,0,1">

            <StackPanel x:Name="FavoritesBar"
                        Orientation="Horizontal"
                        Height="32"
                        VerticalAlignment="Center"
                        Margin="6,0"/>
        </Border>

        <!-- =========================
             WEB
             ========================= -->
        <ContentControl x:Name="WebHost"
                        Grid.Row="3"
                        Grid.Column="0"
                        Background="{StaticResource FluentBg}"/>

        <!-- =========================
             SIDEBAR
             ========================= -->
        <Grid Grid.Row="3" Grid.Column="1" Panel.ZIndex="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ToggleSidebarBtn"
                    Grid.Column="0"
                    Content="❮"
                    Width="24"
                    Height="48"
                    Click="ToggleSidebar_Click"/>

            <Border x:Name="Sidebar"
                    Grid.Column="1"
                    Width="56"
                    Background="#1E1E1E">
                <StackPanel Margin="0,48,0,0">
                    <Button Content="⚙" Margin="10" Click="OpenSettings_Click" Cursor="Hand"/>
                    <Button Content="🌐" Margin="6"/>
                    <Button Content="🔒" Margin="6"/>
                    <Button Content="📜"
                            Margin="6"
                            ToolTip="Historique"
                            Click="OpenHistory_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
