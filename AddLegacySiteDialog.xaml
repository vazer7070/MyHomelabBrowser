<controles:DialogWindow x:Class="MyHomelabBrowser.AddLegacySiteDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Title="Ajouter un site Legacy"
                        Width="420">
    <StackPanel>
        <TextBlock Text="Domaine à forcer en Legacy" Style="{StaticResource DialogHintStyle}" Margin="0,0,0,6"/>
        <TextBox x:Name="DomainBox" TextChanged="DomainBox_TextChanged"/>
        <TextBlock Text="Exemple : jeu.exemple.com"
                   Style="{StaticResource DialogHintStyle}"
                   FontSize="11.5"
                   Margin="0,4,0,0"/>

        <StackPanel Style="{StaticResource DialogButtonBarStyle}">
            <Button Content="Annuler" Command="ApplicationCommands.Close" Margin="0,0,8,0"/>
            <Button x:Name="OkBtn"
                    Content="Ajouter"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="OkBtn_Click"/>
        </StackPanel>
    </StackPanel>
</controles:DialogWindow>
