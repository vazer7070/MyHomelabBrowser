<Window x:Class="MyHomelabBrowser.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changelog"
        Height="540"
        Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource FluentBg}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="📜 Changelog"
                       FontSize="22"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="TitleText"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ===== CONTENT CARD ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource FluentSurface}"
                CornerRadius="14"
                Padding="18">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel x:Name="ChangelogHost"/>

            </ScrollViewer>
        </Border>

        <!-- ===== FOOTER ===== -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Content="Fermer"
                    Padding="22,10"
                    MinWidth="110"
                    Background="{StaticResource SurfaceHoverBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
