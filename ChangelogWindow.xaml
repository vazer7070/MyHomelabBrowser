<Window x:Class="MyHomelabBrowser.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changelog"
        Height="520"
        Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource FluentBg}"
        Foreground="White"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Text="Changelog"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                Background="#2B2B2B"
                CornerRadius="10"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ChangelogText"
                           TextWrapping="Wrap"
                           Foreground="#E0E0E0"
                           FontFamily="Consolas"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Fermer"
                    Padding="18,8"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>