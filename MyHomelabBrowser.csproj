<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>

		<!-- ✅ Version app -->
		<Version>0.9.8</Version>
		<AssemblyVersion>0.9.8.0</AssemblyVersion>
		<FileVersion>0.9.8.0</FileVersion>

		<ApplicationIcon>PommeBrowser_desktop.ico</ApplicationIcon>

		<!-- Tests, serveur de support et édition Linux vivent dans le même dépôt : ils ne font pas partie de l'application Windows. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);tests\**;support-server\**;linux\**;avalonia\**;build\**</DefaultItemExcludes>
	</PropertyGroup>

	<PropertyGroup>
		<!--
			Adresse publique du serveur de support (voir support-server/README.md).
			Vide : les rapports sont enregistrés sur l'ordinateur de l'utilisateur.
			Priorité : -p:SupportApiUrl=…, puis la variable d'environnement
			POMMEBROWSER_SUPPORT_API_URL, puis l'adresse écrite sur la seconde ligne.
		-->
		<SupportApiUrl Condition="'$(SupportApiUrl)' == ''">$(POMMEBROWSER_SUPPORT_API_URL)</SupportApiUrl>
		<SupportApiUrl Condition="'$(SupportApiUrl)' == ''"></SupportApiUrl>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="SupportApiUrl" Value="$(SupportApiUrl)" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Assets\logo.png" />
		<None Remove="Assets\PommeBrowser_desktop.ico" />
		<None Remove="Assets\PommeBrowser_geek.png" />
		<None Remove="Assets\ssl_bad.png" />
		<None Remove="Assets\ssl_ok.png" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="PommeBrowser_desktop.ico" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\logo.png" />
		<Resource Include="Assets\PommeBrowser_desktop.ico" />
		<Resource Include="Assets\PommeBrowser_geek.png" />
		<Resource Include="Assets\ssl_bad.png" />
		<Resource Include="Assets\ssl_ok.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
		<!-- Argon2id : clé du coffre des mots de passe. -->
		<PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
		<PackageReference Include="Velopack" Version="1.2.0" />
	</ItemGroup>


	<ItemGroup>
		<!-- Traduction anglaise de l'interface (clé = texte français). -->
		<EmbeddedResource Include="lang\en.json" LogicalName="lang.en.json" />
	</ItemGroup>

	<!--
		Ruffle embarqué : téléchargé et vérifié à la compilation (commun avec l'édition Linux).
		Ses fichiers sont ajoutés par la cible, après téléchargement : une liste figée ici réclamerait
		encore ceux de la version précédente après un changement de version.
	-->
	<Import Project="build\Ruffle.targets" />
</Project>