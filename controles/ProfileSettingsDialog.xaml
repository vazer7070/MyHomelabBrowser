<Window x:Class="MyHomelabBrowser.controles.ProfileSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres du profil"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None">

    <Border Padding="20"
            Background="#1E1E1E"
            CornerRadius="12"
            BorderBrush="#2D2D2D"
            BorderThickness="1">

        <StackPanel Width="320">

            <!-- TITRE -->
            <TextBlock Text="Profil"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       Margin="0,0,0,16"/>

            <!-- NOM -->
            <TextBlock Text="Nom d’utilisateur"
                       Foreground="#CCCCCC"
                       Margin="0,0,0,4"/>

            <TextBox x:Name="UsernameBox"
                     Height="34"
                     Padding="10,4"
                     VerticalContentAlignment="Center"
                     Background="#252525"
                     Foreground="White"
                     BorderBrush="#3A3A3A"
                     BorderThickness="1"/>

            <!-- MOT DE PASSE -->
            <TextBlock Text="Nouveau mot de passe"
                       Foreground="#CCCCCC"
                       Margin="0,12,0,4"/>

            <PasswordBox x:Name="PasswordBox"
                         Height="34"
                         Padding="10,4"
                         VerticalContentAlignment="Center"
                         Background="#252525"
                         Foreground="White"
                         BorderBrush="#3A3A3A"
                         BorderThickness="1"/>

            <!-- ACTIONS -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button Content="Supprimer"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        Background="Transparent"
                        Foreground="#FF6B6B"
                        BorderBrush="#FF6B6B"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Delete_Click"/>

                <Button Content="Enregistrer"
                        Padding="16,6"
                        Background="#0078D4"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Save_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
