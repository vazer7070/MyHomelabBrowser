<controles:DialogWindow x:Class="MyHomelabBrowser.controles.ProfileSettingsDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Title="Paramètres du profil"
                        Width="500">
    <controles:DialogWindow.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </controles:DialogWindow.Resources>

    <StackPanel>
        <TextBlock Text="Modifiez les informations et la sécurité du profil actif"
                   Style="{StaticResource DialogHintStyle}"
                   Margin="0,0,0,16"/>

        <TextBlock Text="Identité" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="Nom d’utilisateur" Style="{StaticResource DialogHintStyle}" Margin="0,0,0,6"/>
                <TextBox x:Name="UsernameBox"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Sécurité du profil" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="Nouveau mot de passe du profil" Style="{StaticResource DialogHintStyle}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox"/>
                <TextBlock Text="Laissez vide pour garder le mot de passe actuel."
                           Style="{StaticResource DialogHintStyle}"
                           FontSize="11.5"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Coffre des mots de passe" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource SectionCard}">
            <WrapPanel>
                <Button Content="Ouvrir le coffre" Margin="0,0,8,0" Click="Passwords_Click"/>
                <Button Content="Changer le mot de passe du coffre" Click="ChangeVaultPassword_Click"/>
            </WrapPanel>
        </Border>

        <Grid Margin="0,4,0,0">
            <Button Content="Supprimer le profil"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Delete_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Command="ApplicationCommands.Close" Margin="0,0,8,0"/>
                <Button Content="Enregistrer"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</controles:DialogWindow>
