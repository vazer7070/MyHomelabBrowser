<Window x:Class="MyHomelabBrowser.controles.ProfileSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres du profil"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None">

    <Border Background="{StaticResource PanelBrush}"
            CornerRadius="18"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="32">

        <Grid Width="440">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <StackPanel Grid.Row="0" Margin="0,0,0,28">
                <TextBlock Text="Paramètres du profil"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Modifiez les informations et la sécurité du profil actif"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- ================= IDENTITÉ ================= -->
            <StackPanel Grid.Row="1" Margin="0,0,0,24">
                <TextBlock Text="Identité"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,14"/>

                <Border Background="{StaticResource SurfaceRaisedBrush}"
                        CornerRadius="12"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Padding="18">

                    <StackPanel>
                        <TextBlock Text="Nom d’utilisateur"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="2,0,0,8"/>

                        <TextBox x:Name="UsernameBox"
                                 Height="40"
                                 Padding="14,0"
                                 Background="{StaticResource PanelBrush}"
                                 Foreground="White"
                                 BorderBrush="{StaticResource BorderStrongBrush}"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                </Border>
            </StackPanel>

            <!-- ================= SÉCURITÉ PROFIL + COFFRE ================= -->
            <StackPanel Grid.Row="2" Margin="0,0,0,26">

                <!-- ===== Sécurité du profil ===== -->
                <TextBlock Text="Sécurité du profil"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,14"/>

                <Border Background="{StaticResource SurfaceRaisedBrush}"
                        CornerRadius="12"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Padding="18"
                        Margin="0,0,0,24">

                    <StackPanel>
                        <TextBlock Text="Nouveau mot de passe du profil"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="2,0,0,8"/>

                        <PasswordBox x:Name="PasswordBox"
                                     Height="40"
                                     Padding="14,0"
                                     Background="{StaticResource PanelBrush}"
                                     Foreground="White"
                                     BorderBrush="{StaticResource BorderStrongBrush}"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"/>
                    </StackPanel>

                </Border>

                <!-- ===== Coffre ===== -->
                <TextBlock Text="Coffre des mots de passe"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,14"/>

                <Border Background="{StaticResource SurfaceRaisedBrush}"
                        CornerRadius="12"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Padding="18">

                    <StackPanel>
                        <Button Content="Ouvrir le coffre"
                                Margin="0,0,0,12"
                                Height="38"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                Foreground="White"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                Click="Passwords_Click"/>

                        <Button Content="Changer le mot de passe du coffre"
                                Height="38"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                Foreground="White"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                Click="ChangeVaultPassword_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ================= ACTIONS ================= -->
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Supprimer le profil"
                        Padding="18,10"
                        MinWidth="160"
                        Height="40"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        Foreground="{StaticResource DangerBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Delete_Click"/>

                <Button Grid.Column="1"
                        Content="Retour"
                        Margin="0,0,14,0"
                        Padding="22,10"
                        MinWidth="110"
                        Height="40"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        Foreground="White"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        IsCancel="True"/>

                <Button Grid.Column="2"
                        Content="Enregistrer"
                        Padding="26,10"
                        MinWidth="130"
                        Height="40"
                        FontWeight="SemiBold"
                        Background="{StaticResource AccentStrongBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Save_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentStrongBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window>
