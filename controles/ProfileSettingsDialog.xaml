<Window x:Class="MyHomelabBrowser.controles.ProfileSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres du profil"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None">

    <Border Background="#1E1E1E"
            CornerRadius="14"
            BorderBrush="#2D2D2D"
            BorderThickness="1"
            Padding="24">

        <Grid Width="360">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Profil"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Modifier les informations du profil actif"
                           FontSize="12"
                           Foreground="#9A9A9A"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- CARD : IDENTITÉ -->
            <Border Grid.Row="1"
                    Background="#232323"
                    CornerRadius="10"
                    BorderBrush="#2F2F2F"
                    BorderThickness="1"
                    Padding="16"
                    Margin="0,0,0,14">

                <StackPanel>
                    <TextBlock Text="Nom d’utilisateur"
                               Foreground="#CFCFCF"
                               FontSize="12"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="UsernameBox"
                             Height="36"
                             Padding="12,4"
                             Background="#1B1B1B"
                             Foreground="White"
                             BorderBrush="#3A3A3A"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- CARD : SÉCURITÉ -->
            <Border Grid.Row="2"
                    Background="#232323"
                    CornerRadius="10"
                    BorderBrush="#2F2F2F"
                    BorderThickness="1"
                    Padding="16"
                    Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock Text="Sécurité"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Nouveau mot de passe"
                               Foreground="#CFCFCF"
                               FontSize="12"
                               Margin="0,0,0,6"/>

                    <PasswordBox x:Name="PasswordBox"
                                 Height="36"
                                 Padding="12,4"
                                 Background="#1B1B1B"
                                 Foreground="White"
                                 BorderBrush="#3A3A3A"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"/>

                    <Button Content="Mots de passe enregistrés"
                            Margin="0,14,0,0"
                            Padding="14,8"
                            HorizontalAlignment="Left"
                            Background="#2A2A2A"
                            Foreground="White"
                            BorderBrush="#3A3A3A"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="Passwords_Click"/>
                </StackPanel>
            </Border>

            <!-- ACTIONS -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- DANGER -->
                <Button Grid.Column="0"
                        Content="Supprimer le profil"
                        Padding="14,8"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        Foreground="#FF6B6B"
                        BorderBrush="#FF6B6B"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Delete_Click"/>

                <!-- PRIMARY -->
                <Button Grid.Column="1"
                        Content="Enregistrer"
                        Padding="18,8"
                        Background="#0078D4"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Save_Click"/>
            </Grid>

        </Grid>
    </Border>
</Window>
