<UserControl x:Class="MyHomelabBrowser.controles.EmptyStartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}"
             Loaded="StartPage_Loaded">

    <UserControl.Resources>
        <!-- Logo décodé à sa taille d'affichage (l'original fait 1024 px, soit 4 Mo en mémoire). -->
        <BitmapImage x:Key="LogoImage"
                     UriSource="pack://application:,,,/Assets/PommeBrowser_geek.png"
                     DecodePixelWidth="256"
                     CacheOption="OnLoad"/>

        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="12"
                                Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="520">
            <StackPanel x:Name="CenterPanel"
                        Width="600"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,40,0,60">

                <!-- ================= BRANDING ================= -->
                <Image Source="{StaticResource LogoImage}"
                       Width="96"
                       Height="96"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <TextBlock Text="PommeBrowser"
                           Margin="0,14,0,0"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="GreetingText"
                           Text="Rapide · Minimal · Maîtrisé"
                           FontSize="13"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,28"/>

                <!-- ================= RECHERCHE ================= -->
                <!-- ZIndex : les suggestions passent au-dessus de l'aide et des favoris. -->
                <Grid Panel.ZIndex="10">
                    <Border x:Name="SearchBorder"
                            Height="52"
                            Padding="18,0,10,0"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            CornerRadius="26"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="&#xE721;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource AddressBarTextBoxStyle}"
                                         FontSize="15"
                                         Padding="0"
                                         TextChanged="SearchBox_TextChanged"
                                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                                         LostKeyboardFocus="SearchBox_LostKeyboardFocus"/>

                                <TextBlock x:Name="SearchPlaceholder"
                                           Text="Rechercher ou saisir une adresse"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button x:Name="ClearButton"
                                    Grid.Column="2"
                                    Style="{StaticResource InlineIconButtonStyle}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    ToolTip="Effacer"
                                    Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NonEmptyToVisibility}}"
                                    Click="ClearSearch_Click">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Suggestions : en surimpression sous le champ, sans décaler la page -->
                    <Canvas VerticalAlignment="Bottom" Panel.ZIndex="10" ClipToBounds="False">
                        <Border x:Name="SuggestionsBorder"
                                Canvas.Top="6"
                                Width="{Binding ActualWidth, ElementName=SearchBorder}"
                                Padding="5"
                                Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                Effect="{StaticResource PopupShadow}"
                                Visibility="Collapsed">

                            <ListBox x:Name="SuggestionsList"
                                     MaxHeight="300"
                                     SelectionMode="Single"
                                     Focusable="False"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PreviewMouseDown="SuggestionsList_PreviewMouseDown"
                                     PreviewMouseLeftButtonUp="SuggestionsList_MouseUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Icon}"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextTertiaryBrush}"/>

                                            <TextBlock Grid.Column="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="13.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding Prefix, Mode=OneWay}"/><Run Text="{Binding Match, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><Run Text="{Binding Suffix, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Canvas>
                </Grid>

                <TextBlock x:Name="SearchHint"
                           Text="Entrée pour ouvrir · ↑ ↓ pour choisir une suggestion"
                           FontSize="12"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>

                <!-- ================= FAVORIS ================= -->
                <StackPanel x:Name="FavoritesSection" Margin="0,36,0,0" Visibility="Collapsed">
                    <TextBlock Text="Favoris"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <ItemsControl x:Name="FavoritesTiles" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" MaxWidth="600"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButtonStyle}"
                                        ToolTip="{Binding Url}"
                                        Tag="{Binding Url}"
                                        Click="FavoriteTile_Click">
                                    <StackPanel>
                                        <Border Width="44" Height="44"
                                                CornerRadius="22"
                                                Background="{StaticResource SurfaceRaisedBrush}"
                                                HorizontalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasNoIcon, Converter={StaticResource BoolToVisibility}}"/>
                                                <Image Source="{Binding Icon}"
                                                       Width="22" Height="22"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Title}"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   MaxWidth="92"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
