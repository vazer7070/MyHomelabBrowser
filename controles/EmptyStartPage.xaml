<UserControl x:Class="MyHomelabBrowser.controles.EmptyStartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#171717">

    <Grid>
        <!-- Centre -->
        <Grid VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Width="560">

            <StackPanel HorizontalAlignment="Center">

                <!-- LOGO -->
                <Border Width="96"
                        Height="96"
                        CornerRadius="20"
                        Background="#222222"
                        Margin="0,0,0,18"
                        ClipToBounds="True">

                    <Viewbox Stretch="Uniform">
                        <Image Source="/Assets/logo.png"/>
                    </Viewbox>

                </Border>

                <!-- TITRE -->
                <TextBlock Text="PommeBrowser"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Rapide • Minimal • Maîtrisé"
                           FontSize="13"
                           Foreground="#A0A0A0"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,28"/>

                <!-- OMNIBOX -->
                <Border x:Name="SearchBorder"
                        Width="560"
                        Height="56"
                        Padding="18"
                        Background="#2B2B2B"
                        CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="#2B2B2B">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFocused, ElementName=SearchBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="#4A90E2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icône -->
                        <TextBlock Text="🔍"
                                   FontSize="16"
                                   Foreground="#BBBBBB"
                                   VerticalAlignment="Center"
                                   Margin="4,0,12,0"/>

                        <!-- Texte -->
                        <Grid Grid.Column="1">

                            <TextBox x:Name="SearchBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="White"
                                     FontSize="15"
                                     CaretBrush="White"
                                     Height="20"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown"
                                     LostKeyboardFocus="SearchBox_LostKeyboardFocus"/>

                            <!-- Placeholder -->
                            <TextBlock Text="Rechercher ou saisir une adresse"
                                       Foreground="#888888"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                                                    <Condition Binding="{Binding IsFocused, ElementName=SearchBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </Grid>

                        <!-- CLEAR -->
                        <Button x:Name="ClearButton"
                                Grid.Column="2"
                                Width="26"
                                Height="26"
                                Content="✕"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#AAAAAA"
                                VerticalAlignment="Center"
                                Click="ClearSearch_Click">

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                        </Button>

                    </Grid>
                </Border>

                <!-- DROPDOWN SUGGESTIONS -->
                <Border x:Name="SuggestionsBorder"
                        Width="560"
                        Margin="0,8,0,0"
                        Background="#1E1E1E"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#2F2F2F"
                        Visibility="Collapsed">

                    <ListBox x:Name="SuggestionsList"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="260"
                             SelectionMode="Single"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseDown="SuggestionsList_PreviewMouseDown"
                             SelectionChanged="SuggestionsList_SelectionChanged"
                             LostKeyboardFocus="SuggestionsList_LostKeyboardFocus">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icône -->
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="14"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
           TextWrapping="NoWrap"
           Foreground="#DDDDDD">
                                        <TextBlock.Inlines>
                                            <Run Text="{Binding Prefix}"/>
                                            <Run Text="{Binding Match}"
             FontWeight="SemiBold"
             Foreground="White"/>
                                            <Run Text="{Binding Suffix}"
             Foreground="#B0B0B0"/>
                                        </TextBlock.Inlines>
                                    </TextBlock>

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2D2D2D"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#252525"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                    </ListBox>

                </Border>

                <!-- Hint -->
                <TextBlock Text="Appuyez sur Entrée pour lancer la navigation"
                           FontSize="12"
                           Foreground="#7A7A7A"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
