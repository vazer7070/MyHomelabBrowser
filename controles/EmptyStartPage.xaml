<UserControl x:Class="MyHomelabBrowser.controles.EmptyStartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}">

    <!-- ================= RESOURCES ================= -->
    <UserControl.Resources>
        <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut"/>

        <Storyboard x:Key="SparkleLoop" RepeatBehavior="Forever">

            <!-- SP1 -->
            <DoubleAnimation Storyboard.TargetName="Sp1" Storyboard.TargetProperty="Opacity"
                             BeginTime="0:0:0.10" From="0" To="0.75" Duration="0:0:0.18" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Sp1Scale" Storyboard.TargetProperty="ScaleX"
                             BeginTime="0:0:0.10" From="0.6" To="1.35" Duration="0:0:0.18" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Sp1Scale" Storyboard.TargetProperty="ScaleY"
                             BeginTime="0:0:0.10" From="0.6" To="1.35" Duration="0:0:0.18" AutoReverse="True"/>

            <!-- SP2 -->
            <DoubleAnimation Storyboard.TargetName="Sp2" Storyboard.TargetProperty="Opacity"
                             BeginTime="0:0:0.65" From="0" To="0.65" Duration="0:0:0.16" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Sp2Scale" Storyboard.TargetProperty="ScaleX"
                             BeginTime="0:0:0.65" From="0.6" To="1.30" Duration="0:0:0.16" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Sp2Scale" Storyboard.TargetProperty="ScaleY"
                             BeginTime="0:0:0.65" From="0.6" To="1.30" Duration="0:0:0.16" AutoReverse="True"/>

            <!-- SP3 -->
            <DoubleAnimation Storyboard.TargetName="Sp3" Storyboard.TargetProperty="Opacity"
                             BeginTime="0:0:1.10" From="0" To="0.70" Duration="0:0:0.20" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Sp3Scale" Storyboard.TargetProperty="ScaleX"
                             BeginTime="0:0:1.10" From="0.6" To="1.40" Duration="0:0:0.20" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Sp3Scale" Storyboard.TargetProperty="ScaleY"
                             BeginTime="0:0:1.10" From="0.6" To="1.40" Duration="0:0:0.20" AutoReverse="True"/>

        </Storyboard>

    </UserControl.Resources>

    <!-- ================= ROOT ================= -->
    <Grid>

        <!-- Centre -->
        <Grid VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Width="560">

            <!-- ✅ Layout corrigé (mais contenu conservé) -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= BRANDING ================= -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,28">

                <!-- LOGO INTÉGRÉ, AUCUN CARRÉ, OMBRE RESPECTANT L'ALPHA -->
                <Grid Width="128"
                      Height="128"
                      Margin="0,16,0,18"
                      Loaded="LogoHost_Loaded"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <!-- Lueur douce basée sur l'alpha -->
                    <Image Source="pack://application:,,,/Assets/PommeBrowser_geek.png"
                           Width="128"
                           Height="128"
                           Opacity="0.25"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <BlurEffect Radius="12"/>
                        </Image.Effect>
                    </Image>

                    <!-- Logo principal (NET, FIXE) -->
                    <Image Source="pack://application:,,,/Assets/PommeBrowser_geek.png"
                           Width="128"
                           Height="128"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Sparkles (overlay, très léger) -->
                    <Canvas IsHitTestVisible="False">

                        <Ellipse x:Name="Sp1" Width="6" Height="6" Opacity="0"
                                 Fill="#BFE9FF" Canvas.Left="22" Canvas.Top="28">
                            <Ellipse.Effect>
                                <BlurEffect Radius="4"/>
                            </Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="Sp1Scale" CenterX="3" CenterY="3"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <Ellipse x:Name="Sp2" Width="4" Height="4" Opacity="0"
                                 Fill="#9FD8FF" Canvas.Left="64" Canvas.Top="36">
                            <Ellipse.Effect>
                                <BlurEffect Radius="3"/>
                            </Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="Sp2Scale" CenterX="2" CenterY="2"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <Ellipse x:Name="Sp3" Width="5" Height="5" Opacity="0"
                                 Fill="#D7FFFA" Canvas.Left="48" Canvas.Top="64">
                            <Ellipse.Effect>
                                <BlurEffect Radius="4"/>
                            </Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="Sp3Scale" CenterX="2.5" CenterY="2.5"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                    </Canvas>
                </Grid>

                <!-- ================= TITRE ================= -->
                <TextBlock Text="PommeBrowser"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Rapide • Minimal • Maîtrisé"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <!-- ================= OMNIBOX + SUGGESTIONS ================= -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center">

                <!-- ================= OMNIBOX ================= -->
                <Border x:Name="SearchBorder"
                        Width="560"
                        Height="60"
                        Padding="16,10"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush}">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFocused, ElementName=SearchBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icône -->
                        <TextBlock Text="🔍"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,12,0"/>

                        <!-- Texte -->
                        <Grid Grid.Column="1">

                            <TextBox x:Name="SearchBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="White"
                                     FontSize="15"
                                     CaretBrush="White"
                                     MinHeight="0"
                                     Padding="0"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown"
                                     LostKeyboardFocus="SearchBox_LostKeyboardFocus"/>

                            <!-- Placeholder -->
                            <TextBlock Text="Rechercher ou saisir une adresse"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                                                    <Condition Binding="{Binding IsFocused, ElementName=SearchBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </Grid>

                        <!-- CLEAR -->
                        <Button x:Name="ClearButton"
                                Grid.Column="2"
                                Width="26"
                                Height="26"
                                Content="✕"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                VerticalAlignment="Center"
                                Click="ClearSearch_Click">

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                        </Button>

                    </Grid>
                </Border>

                <!-- ================= SUGGESTIONS ================= -->
                <Border x:Name="SuggestionsBorder"
                        Width="560"
                        Margin="0,8,0,0"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#2F2F2F"
                        Visibility="Collapsed">

                    <ListBox x:Name="SuggestionsList"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="260"
                             SelectionMode="Single"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseDown="SuggestionsList_PreviewMouseDown"
                             SelectionChanged="SuggestionsList_SelectionChanged"
                             LostKeyboardFocus="SuggestionsList_LostKeyboardFocus">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="14"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               TextWrapping="NoWrap"
                                               Foreground="{StaticResource TextPrimaryBrush}">
                                        <TextBlock.Inlines>
                                            <Run Text="{Binding Prefix}"/>
                                            <Run Text="{Binding Match}"
                                                 FontWeight="SemiBold"
                                                 Foreground="White"/>
                                            <Run Text="{Binding Suffix}"
                                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </TextBlock.Inlines>
                                    </TextBlock>

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                    </ListBox>
                </Border>

            </StackPanel>

            <!-- ================= HINT ================= -->
            <TextBlock Grid.Row="2"
                       Text="Appuyez sur Entrée pour lancer la navigation"
                       FontSize="12"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0"/>

        </Grid>
    </Grid>
</UserControl>
