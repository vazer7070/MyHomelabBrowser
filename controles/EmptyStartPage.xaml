<UserControl x:Class="MyHomelabBrowser.controles.EmptyStartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
             xmlns:homelab="clr-namespace:MyHomelabBrowser.classes.Homelab"
             Background="{StaticResource WindowBackgroundBrush}"
             Loaded="StartPage_Loaded"
             Unloaded="StartPage_Unloaded">

    <UserControl.Resources>
        <controles:FaviconForUrlConverter x:Key="FaviconForUrl"/>

        <!-- Logo décodé à sa taille d'affichage (l'original fait 1024 px, soit 4 Mo en mémoire). -->
        <BitmapImage x:Key="LogoImage"
                     UriSource="pack://application:,,,/Assets/PommeBrowser_geek.png"
                     DecodePixelWidth="256"
                     CacheOption="OnLoad"/>

        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="12"
                                Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="520">
            <StackPanel x:Name="CenterPanel"
                        Width="600"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,40,0,60">

                <!-- ================= BRANDING ================= -->
                <Image Source="{StaticResource LogoImage}"
                       Width="96"
                       Height="96"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <TextBlock Text="PommeBrowser"
                           Margin="0,14,0,0"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="GreetingText"
                           Text="Rapide · Minimal · Maîtrisé"
                           FontSize="13"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,28"/>

                <!-- ================= RECHERCHE ================= -->
                <!-- ZIndex : les suggestions passent au-dessus de l'aide et des favoris. -->
                <Grid Panel.ZIndex="10">
                    <Border x:Name="SearchBorder"
                            Height="52"
                            Padding="18,0,10,0"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            CornerRadius="26"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="&#xE721;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource AddressBarTextBoxStyle}"
                                         FontSize="15"
                                         Padding="0"
                                         TextChanged="SearchBox_TextChanged"
                                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                                         LostKeyboardFocus="SearchBox_LostKeyboardFocus"/>

                                <TextBlock x:Name="SearchPlaceholder"
                                           Text="Rechercher ou saisir une adresse"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button x:Name="ClearButton"
                                    Grid.Column="2"
                                    Style="{StaticResource InlineIconButtonStyle}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    ToolTip="Effacer"
                                    Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NonEmptyToVisibility}}"
                                    Click="ClearSearch_Click">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Suggestions : en surimpression sous le champ, sans décaler la page -->
                    <Canvas VerticalAlignment="Bottom" Panel.ZIndex="10" ClipToBounds="False">
                        <Border x:Name="SuggestionsBorder"
                                Canvas.Top="6"
                                Width="{Binding ActualWidth, ElementName=SearchBorder}"
                                Padding="5"
                                Background="{StaticResource PanelBrush}"
                                CornerRadius="14"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                Effect="{StaticResource PopupShadow}"
                                Visibility="Collapsed">

                            <ListBox x:Name="SuggestionsList"
                                     MaxHeight="300"
                                     SelectionMode="Single"
                                     Focusable="False"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PreviewMouseDown="SuggestionsList_PreviewMouseDown"
                                     PreviewMouseLeftButtonUp="SuggestionsList_MouseUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Icon}"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextTertiaryBrush}"/>

                                            <TextBlock Grid.Column="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="13.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding Prefix, Mode=OneWay}"/><Run Text="{Binding Match, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><Run Text="{Binding Suffix, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Canvas>
                </Grid>

                <TextBlock x:Name="SearchHint"
                           Text="Entrée pour ouvrir · ↑ ↓ pour choisir une suggestion"
                           FontSize="12"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>

                <!-- ================= SERVICES ================= -->
                <StackPanel x:Name="ServicesSection" Margin="0,36,0,0">
                    <Grid Margin="6,0,6,6">
                        <TextBlock Text="Mes services"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CheckAllServicesButton"
                                    Style="{StaticResource TextButtonStyle}"
                                    FontSize="12"
                                    MinHeight="24"
                                    Padding="8,2"
                                    ToolTip="Vérifier l’état de tous les services"
                                    Click="CheckAllServices_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Actualiser"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TextButtonStyle}"
                                    FontSize="12"
                                    MinHeight="24"
                                    Padding="8,2"
                                    Click="AddService_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Ajouter"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="ServicesTiles" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" MaxWidth="600"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="GroupHeader"
                                                   Text="{Binding Name}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,0"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                                <Setter TargetName="GroupHeader" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type homelab:ServiceTile}">
                                <Button Style="{StaticResource TileButtonStyle}"
                                        Width="116"
                                        Height="104"
                                        Tag="{Binding}"
                                        Click="ServiceTile_Click"
                                        PreviewMouseUp="ServiceTile_PreviewMouseUp">
                                    <Button.ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Url}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StatusText}"/>
                                        </StackPanel>
                                    </Button.ToolTip>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Ouvrir dans un nouvel onglet" Click="ServiceOpenInNewTab_Click"/>
                                            <MenuItem Header="Vérifier maintenant" Click="ServiceCheck_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Modifier…" Click="ServiceEdit_Click"/>
                                            <MenuItem Header="Supprimer" Click="ServiceDelete_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel>
                                        <Grid Width="46" Height="46" HorizontalAlignment="Center">
                                            <Border Width="44" Height="44"
                                                    CornerRadius="22"
                                                    Background="{StaticResource SurfaceRaisedBrush}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}"
                                                               FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Border Width="44" Height="44" CornerRadius="22"
                                                            Background="{StaticResource SurfaceRaisedBrush}"
                                                            Visibility="{Binding Source, ElementName=ServiceIcon, Converter={StaticResource NonEmptyToVisibility}}">
                                                        <Image x:Name="ServiceIcon"
                                                               Source="{Binding Url, Converter={StaticResource FaviconForUrl}}"
                                                               Width="22" Height="22"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Ellipse x:Name="StatusDot"
                                                     Width="13" Height="13"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     StrokeThickness="2.5"
                                                     Stroke="{StaticResource WindowBackgroundBrush}"
                                                     Fill="{StaticResource TextTertiaryBrush}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="0,7,0,0"
                                                   FontSize="12"
                                                   MaxWidth="100"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                        <TextBlock x:Name="StatusLabel"
                                                   Text="{Binding StatusText}"
                                                   FontSize="10.5"
                                                   MaxWidth="104"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Online">
                                        <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Degraded">
                                        <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Offline">
                                        <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource DangerBrush}"/>
                                        <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Aucun service : invitation à en ajouter -->
                    <Border x:Name="ServicesEmptyState"
                            Margin="6,4,6,0"
                            Padding="16,14"
                            CornerRadius="12"
                            Background="{StaticResource SurfaceBrush}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Ajoutez les services de votre homelab (NAS, Proxmox, routeur…) pour voir d’un coup d’œil s’ils répondent."
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="Ajouter un service" Click="AddService_Click" Margin="0,0,8,0"/>
                                <Button x:Name="ImportLocalFavoritesButton"
                                        Style="{StaticResource TextButtonStyle}"
                                        Click="ImportLocalFavorites_Click"
                                        Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= FAVORIS ================= -->
                <StackPanel x:Name="FavoritesSection" Margin="0,36,0,0" Visibility="Collapsed">
                    <TextBlock Text="Favoris"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <ItemsControl x:Name="FavoritesTiles" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" MaxWidth="600"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButtonStyle}"
                                        ToolTip="{Binding Url}"
                                        Tag="{Binding Url}"
                                        Click="FavoriteTile_Click">
                                    <StackPanel>
                                        <Border Width="44" Height="44"
                                                CornerRadius="22"
                                                Background="{StaticResource SurfaceRaisedBrush}"
                                                HorizontalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasNoIcon, Converter={StaticResource BoolToVisibility}}"/>
                                                <Image Source="{Binding Icon}"
                                                       Width="22" Height="22"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Title}"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   MaxWidth="92"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
