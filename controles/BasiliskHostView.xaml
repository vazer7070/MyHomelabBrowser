<UserControl x:Class="MyHomelabBrowser.controles.BasiliskHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyHomelabBrowser.controles"
             Background="{StaticResource PanelBrush}">
    <Grid>
        <!-- Host Win32 -->
        <local:ExternalWindowDock x:Name="Host"/>


        <!-- Overlay status -->
        <Border x:Name="Overlay"
                Visibility="Collapsed"
                Background="#CC111111"
                CornerRadius="14"
                Padding="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Width="420">
                <TextBlock x:Name="Title"
                           Text="Mode Legacy (Flash réel)"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="UrlText"
                           Text=""
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="12"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="StatusText"
                           Text="⏳ Lancement de Basilisk..."
                           Foreground="White"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RetryBtn"
                            Content="Retenter Basilisk"
                            Padding="12,6"
                            Margin="0,0,8,0"/>

                    <Button x:Name="SettingsBtn"
                            Content="Paramètres"
                            Padding="12,6"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
