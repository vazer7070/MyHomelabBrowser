<Window x:Class="MyHomelabBrowser.controles.PasswordVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mots de passe enregistrés"
        Width="720"
        Height="540"
        MinWidth="640"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="VaultActionButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfacePressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VaultDangerButton"
               TargetType="Button"
               BasedOn="{StaticResource VaultActionButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="VaultTextButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfacePressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="8"
                              Opacity="0.38"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Grid Margin="24,22,20,18"
                  Background="Transparent"
                  MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="42"
                        Height="42"
                        CornerRadius="12"
                        Background="{StaticResource AccentSoftBrush}">
                    <Viewbox Width="23" Height="23">
                        <Path Fill="{StaticResource AccentBrush}"
                              Data="M12,1A5,5 0 0,0 7,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8H17V6A5,5 0 0,0 12,1M12,3A3,3 0 0,1 15,6V8H9V6A3,3 0 0,1 12,3M12,12A2,2 0 0,1 14,14C14,14.74 13.6,15.39 13,15.73V18H11V15.73C10.4,15.39 10,14.74 10,14A2,2 0 0,1 12,12Z"/>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mots de passe enregistrés"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border Margin="10,1,0,0"
                                Padding="8,3"
                                CornerRadius="8"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="CountText"
                                       Text="0 identifiant"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Les identifiants restent chiffrés dans le profil actif."
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Width="34"
                        Height="34"
                        Background="Transparent"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Fermer"
                        Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Width="13" Height="13">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M2,2 L12,12 M12,2 L2,12"/>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- Recherche -->
            <Border Grid.Row="1"
                    Margin="24,0,24,16"
                    Height="44"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Width="17" Height="17" HorizontalAlignment="Center">
                        <Path Stroke="{StaticResource TextTertiaryBrush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M10.5,10.5 L15,15 M7.5,2 A5.5,5.5 0 1 0 7.5,13 A5.5,5.5 0 1 0 7.5,2"/>
                    </Viewbox>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Padding="0,10"
                             Background="Transparent"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"/>

                    <TextBlock Grid.Column="1"
                               Text="Rechercher un site ou un utilisateur"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               x:Name="SearchPlaceholder"/>

                    <Button x:Name="ClearSearchButton"
                            Grid.Column="2"
                            Width="30"
                            Height="30"
                            Margin="0,0,5,0"
                            Background="Transparent"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            ToolTip="Effacer la recherche"
                            Click="ClearSearch_Click">
                        <Viewbox Width="11" Height="11">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M2,2 L10,10 M10,2 L2,10"/>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- Liste -->
            <Border Grid.Row="2"
                    Margin="24,0,24,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="13">
                <Grid>
                    <ListBox x:Name="CredentialList"
                             Margin="8"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="14,12"
                                        Background="{StaticResource NormalSurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34"
                                                Height="34"
                                                CornerRadius="9"
                                                Background="{StaticResource AccentSoftBrush}">
                                            <Viewbox Width="18" Height="18">
                                                <Path Fill="{StaticResource AccentBrush}"
                                                      Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M19.93,11H16.95A15.65,15.65 0 0,0 15.56,5.82A8.03,8.03 0 0,1 19.93,11M12,4C13.24,5.44 14.15,7.12 14.56,9H9.44C9.85,7.12 10.76,5.44 12,4M4.07,13H7.05A15.65,15.65 0 0,0 8.44,18.18A8.03,8.03 0 0,1 4.07,13M7.05,11H4.07A8.03,8.03 0 0,1 8.44,5.82A15.65,15.65 0 0,0 7.05,11M12,20C10.76,18.56 9.85,16.88 9.44,15H14.56C14.15,16.88 13.24,18.56 12,20M9.05,13H14.95C14.85,13.68 14.7,14.35 14.5,15H9.5C9.3,14.35 9.15,13.68 9.05,13M15.56,18.18A15.65,15.65 0 0,0 16.95,13H19.93A8.03,8.03 0 0,1 15.56,18.18Z"/>
                                            </Viewbox>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Host}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Username}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Margin="9,0"
                                                           Text="•"
                                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource VaultActionButton}"
                                                    ToolTip="Afficher le mot de passe"
                                                    Click="Reveal_Click">
                                                <Viewbox Width="17" Height="17">
                                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M12,9A3,3 0 1,0 12,15A3,3 0 0,0 12,9M12,5C6.5,5 2,9.5 2,12C2,14.5 6.5,19 12,19C17.5,19 22,14.5 22,12C22,9.5 17.5,5 12,5M12,17C8.2,17 4.9,14.2 4.1,12C4.9,9.8 8.2,7 12,7C15.8,7 19.1,9.8 19.9,12C19.1,14.2 15.8,17 12,17Z"/>
                                                </Viewbox>
                                            </Button>

                                            <Button Style="{StaticResource VaultActionButton}"
                                                    ToolTip="Copier le mot de passe"
                                                    Click="Copy_Click">
                                                <Viewbox Width="16" Height="16">
                                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M19,21H8A2,2 0 0,1 6,19V8A2,2 0 0,1 8,6H19A2,2 0 0,1 21,8V19A2,2 0 0,1 19,21M8,8V19H19V8H8M16,2A2,2 0 0,1 18,4V5H16V4H5V15H4A2,2 0 0,1 2,13V4A2,2 0 0,1 4,2H16Z"/>
                                                </Viewbox>
                                            </Button>

                                            <Button Style="{StaticResource VaultDangerButton}"
                                                    ToolTip="Supprimer l’identifiant"
                                                    Click="Delete_Click">
                                                <Viewbox Width="16" Height="16">
                                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"/>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyState"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Border Width="54"
                                Height="54"
                                CornerRadius="16"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                HorizontalAlignment="Center">
                            <Viewbox Width="25" Height="25">
                                <Path Fill="{StaticResource TextTertiaryBrush}"
                                      Data="M12,1A5,5 0 0,0 7,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8H17V6A5,5 0 0,0 12,1M12,3A3,3 0 0,1 15,6V8H9V6A3,3 0 0,1 12,3Z"/>
                            </Viewbox>
                        </Border>
                        <TextBlock x:Name="EmptyTitle"
                                   Margin="0,14,0,0"
                                   Text="Aucun identifiant enregistré"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyDescription"
                                   Margin="0,5,0,0"
                                   Text="Les identifiants enregistrés apparaîtront ici."
                                   FontSize="12"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pied -->
            <Grid Grid.Row="3" Margin="24,16,24,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="StatusBorder"
                        Padding="10,7"
                        CornerRadius="8"
                        Background="{StaticResource AccentSoftBrush}"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed">
                    <TextBlock x:Name="StatusText"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>

                <Button Grid.Column="1"
                        Content="Fermer"
                        Style="{StaticResource VaultTextButton}"
                        Click="Close_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
