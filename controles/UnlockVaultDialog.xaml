<Window x:Class="MyHomelabBrowser.controles.UnlockVaultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Déverrouiller le coffre"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Border Padding="30"
            Width="420"
            Background="{StaticResource PanelBrush}"
            CornerRadius="16"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">

        <StackPanel>

            <!-- ===== TITRE ===== -->
            <TextBlock Text="🔒 Coffre-fort verrouillé"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"
                       Foreground="White"/>

            <TextBlock Text="Entrez le mot de passe du coffre pour continuer."
                       TextWrapping="Wrap"
                       Margin="0,0,0,22"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13"/>

            <!-- ===== PASSWORD ===== -->
            <TextBlock Text="Mot de passe du coffre"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       Margin="0,0,0,6"/>

            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    CornerRadius="10"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    Margin="0,0,0,28">

                <PasswordBox x:Name="PasswordBox"
                             Height="42"
                             Padding="14,0"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0"/>
            </Border>

            <!-- ===== BOUTONS ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Annuler -->
                <Button Grid.Column="0"
                        Content="Annuler"
                        Height="44"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Déverrouiller -->
                <Button Grid.Column="2"
                        Content="Déverrouiller"
                        Height="44"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="{StaticResource AccentStrongBrush}"
                        Foreground="White"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        IsDefault="True"
                        Click="Unlock_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </StackPanel>
    </Border>
</Window>
