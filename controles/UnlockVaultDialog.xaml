<controles:DialogWindow x:Class="MyHomelabBrowser.controles.UnlockVaultDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Title="Coffre verrouillé"
                        Width="420">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36"
                    CornerRadius="18"
                    Margin="0,0,14,0"
                    Background="{StaticResource AccentSoftBrush}">
                <TextBlock Text="&#xE72E;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <TextBlock Grid.Column="1"
                       Text="Entrez le mot de passe du coffre pour continuer."
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Grid>

        <TextBlock Text="Mot de passe du coffre" Style="{StaticResource DialogHintStyle}" Margin="0,0,0,6"/>
        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>

        <StackPanel Style="{StaticResource DialogButtonBarStyle}">
            <Button Content="Annuler" Command="ApplicationCommands.Close" Margin="0,0,8,0"/>
            <Button x:Name="UnlockButton"
                    Content="Déverrouiller"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="Unlock_Click"/>
        </StackPanel>
    </StackPanel>
</controles:DialogWindow>
