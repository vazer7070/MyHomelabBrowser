<controles:DialogWindow x:Class="MyHomelabBrowser.controles.LegacyConfirmDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Title="Flash Legacy"
                        Width="440">
    <StackPanel>
        <TextBlock Text="Activer Flash Legacy (Basilisk) pour cette page ?" TextWrapping="Wrap"/>

        <CheckBox x:Name="AddRuleCheck"
                  Margin="0,14,0,0"
                  Content="Ajouter aussi ce site en “Legacy direct” (automatique)"/>

        <StackPanel Style="{StaticResource DialogButtonBarStyle}">
            <Button Content="Annuler" Command="ApplicationCommands.Close" Margin="0,0,8,0"/>
            <Button Content="Activer" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</controles:DialogWindow>
