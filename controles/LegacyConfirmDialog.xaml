<Window x:Class="MyHomelabBrowser.controles.LegacyConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flash Legacy"
        Width="420"
        Height="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1E1E1E"
            BorderBrush="#444"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE -->
            <TextBlock Text="⚡ Flash Legacy"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"/>

            <!-- CONTENT -->
            <StackPanel Grid.Row="1" Margin="0,10,0,10">
                <TextBlock Text="Activer Flash Legacy (Basilisk) pour cette page ?"
                           Foreground="#D1D5DB"
                           FontSize="13"/>

                <CheckBox x:Name="AddRuleCheck"
                          Margin="0,10,0,0"
                          Foreground="#E5E7EB"
                          Content="Ajouter aussi ce site en “Legacy direct” (automatique)"/>
            </StackPanel>

            <!-- BUTTONS -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Annuler"
                        Margin="0,0,10,0"
                        Padding="14,6"
                        Click="Cancel_Click"/>

                <Button Content="Activer"
                        Padding="14,6"
                        Background="#2563EB"
                        Foreground="White"
                        Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
