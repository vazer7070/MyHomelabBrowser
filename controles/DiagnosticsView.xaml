<UserControl x:Class="MyHomelabBrowser.controles.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="880" Margin="32,28,32,40">
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Diagnostic"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="GeneratedText"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Ouvrir le dossier des données" Margin="0,0,8,0" Click="OpenDataFolder_Click"/>
                    <Button x:Name="CopyButton" Content="Copier le rapport" Margin="0,0,8,0" Click="Copy_Click"/>
                    <Button x:Name="RefreshButton" Content="Actualiser" Style="{StaticResource PrimaryButtonStyle}" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="SectionsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,12,12"
                                Padding="18,14"
                                CornerRadius="12"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="12.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Value, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="0"
                                                         MinHeight="0"
                                                         FontSize="12.5"
                                                         TextWrapping="Wrap"
                                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Journal récent"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,8,0,8"/>
            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="11.5"
                     Height="260"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
