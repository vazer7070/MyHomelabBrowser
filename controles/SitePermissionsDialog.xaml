<controles:DialogWindow x:Class="MyHomelabBrowser.controles.SitePermissionsDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Title="Autorisations des sites"
                        Width="580">
    <StackPanel>
        <TextBlock Text="Choix mémorisés pour ce profil : accès à la caméra, au micro, à la position… et sites autorisés à rester en HTTP. Retirer un choix fera réapparaître la question à la prochaine visite."
                   Style="{StaticResource DialogHintStyle}"
                   Margin="0,0,0,12"/>

        <ListBox x:Name="DecisionsList" MaxHeight="340" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Site}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Permission}" Style="{StaticResource DialogHintStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding State}"
                                   Foreground="{Binding StateBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="12,0"/>
                        <Button Grid.Column="2"
                                Content="Retirer"
                                Style="{StaticResource TextButtonStyle}"
                                VerticalAlignment="Center"
                                Tag="{Binding Decision}"
                                Click="Remove_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyText"
                   Text="Aucun choix mémorisé pour le moment."
                   Style="{StaticResource DialogHintStyle}"
                   Visibility="Collapsed"/>

        <Grid Margin="0,20,0,0">
            <Button x:Name="ClearButton"
                    Content="Tout retirer"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Clear_Click"/>
            <Button Content="Fermer"
                    HorizontalAlignment="Right"
                    Command="ApplicationCommands.Close"
                    IsDefault="True"/>
        </Grid>
    </StackPanel>
</controles:DialogWindow>
