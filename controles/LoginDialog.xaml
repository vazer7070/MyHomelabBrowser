<Window x:Class="MyHomelabBrowser.controles.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Padding="30"
            Width="420"
            Background="{StaticResource PanelBrush}"
            CornerRadius="16"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">

        <StackPanel>

            <!-- ===== TITRE ===== -->
            <TextBlock Text="Connexion"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,24"/>

            <!-- ===== USERNAME ===== -->
            <TextBlock Text="Nom d’utilisateur"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       Margin="0,0,0,6"/>

            <Grid>
                <Border Background="{StaticResource SurfaceRaisedBrush}"
                        CornerRadius="10"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1">
                    <TextBox x:Name="UsernameBox"
                             Height="42"
                             Padding="14,10"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0"/>
                </Border>

                <!-- Placeholder -->
                <TextBlock Text="Entrez votre nom"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=UsernameBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- ===== PASSWORD ===== -->
            <TextBlock Text="Mot de passe"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       Margin="0,18,0,6"/>

            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    CornerRadius="10"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1">

                <PasswordBox x:Name="PasswordBox"
                             Height="42"
                             Padding="14,10"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0">

                    <PasswordBox.RenderTransform>
                        <TranslateTransform x:Name="PasswordShakeTransform"/>
                    </PasswordBox.RenderTransform>

                </PasswordBox>
            </Border>

            <!-- ===== ERREUR ===== -->
            <TextBlock x:Name="PasswordErrorText"
                       Text="Mot de passe incorrect"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12"
                       Margin="6,6,0,0"
                       Visibility="Collapsed"/>

            <!-- ===== BOUTONS ===== -->
            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Annuler -->
                <Button Grid.Column="0"
                        Content="Annuler"
                        Height="44"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Se connecter -->
                <Button Grid.Column="2"
                        x:Name="LoginButton"
                        Content="Se connecter"
                        Height="44"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="{StaticResource AccentStrongBrush}"
                        Foreground="White"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Login_Click"
                        IsEnabled="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </StackPanel>
    </Border>
</Window>
