<controles:DialogWindow x:Class="MyHomelabBrowser.controles.LoginDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Title="Connexion"
                        Width="420">
    <StackPanel>
        <TextBlock Text="Nom d’utilisateur" Style="{StaticResource DialogHintStyle}" Margin="0,0,0,6"/>
        <Grid>
            <TextBox x:Name="UsernameBox" TextChanged="Input_Changed"/>
            <TextBlock Text="Entrez votre nom"
                       Margin="13,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=UsernameBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <TextBlock Text="Mot de passe" Style="{StaticResource DialogHintStyle}" Margin="0,14,0,6"/>
        <PasswordBox x:Name="PasswordBox" PasswordChanged="Input_Changed">
            <PasswordBox.RenderTransform>
                <TranslateTransform x:Name="PasswordShakeTransform"/>
            </PasswordBox.RenderTransform>
        </PasswordBox>

        <TextBlock x:Name="PasswordErrorText"
                   Text="Mot de passe incorrect"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Style="{StaticResource DialogButtonBarStyle}">
            <Button Content="Annuler" Command="ApplicationCommands.Close" Margin="0,0,8,0"/>
            <Button x:Name="LoginButton"
                    Content="Se connecter"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="Login_Click"/>
        </StackPanel>
    </StackPanel>
</controles:DialogWindow>
