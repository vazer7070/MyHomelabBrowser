<controles:DialogWindow x:Class="MyHomelabBrowser.controles.SimplePasswordDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Width="400">
    <StackPanel>
        <TextBlock Text="Mot de passe" Style="{StaticResource DialogHintStyle}" Margin="0,0,0,6"/>
        <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged"/>

        <TextBlock x:Name="ErrorText"
                   Text="Mot de passe incorrect"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Style="{StaticResource DialogButtonBarStyle}">
            <Button Content="Annuler" Command="ApplicationCommands.Close" Margin="0,0,8,0"/>
            <Button x:Name="OkButton"
                    Content="Valider"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</controles:DialogWindow>
