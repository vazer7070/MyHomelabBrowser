<Window x:Class="MyHomelabBrowser.controles.SimplePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">

    <Border Width="420"
            Background="{StaticResource PanelBrush}"
            CornerRadius="16"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="28">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="TitleText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Text="Saisissez le mot de passe du coffre pour continuer."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Text="Mot de passe du coffre"
                       FontSize="13"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,6"/>

            <PasswordBox x:Name="PasswordInput"
                         Grid.Row="2"
                         Height="44"
                         Padding="14,0"
                         FontSize="14"
                         Background="{StaticResource SurfaceRaisedBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderStrongBrush}"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"/>

            <TextBlock x:Name="ErrorText"
                       Grid.Row="3"
                       Text="Mot de passe incorrect"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12"
                       Visibility="Collapsed"
                       Margin="4,7,0,0"/>

            <Grid Grid.Row="4" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Annuler"
                        Height="44"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"/>

                <Button Grid.Column="2"
                        Content="Valider"
                        Height="44"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="Ok_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
