<controles:DialogWindow x:Class="MyHomelabBrowser.controles.MessageDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Width="460">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="IconBadge"
                    Width="36" Height="36"
                    CornerRadius="18"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                <TextBlock x:Name="IconGlyph"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       MinHeight="36"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       FontSize="13.5"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Grid>

        <StackPanel x:Name="ButtonBar" Style="{StaticResource DialogButtonBarStyle}"/>
    </StackPanel>
</controles:DialogWindow>
