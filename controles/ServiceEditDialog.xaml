<controles:DialogWindow x:Class="MyHomelabBrowser.controles.ServiceEditDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Title="Ajouter un service"
                        Width="460">
    <StackPanel>
        <TextBlock Text="Nom" Style="{StaticResource DialogHintStyle}" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox"/>

        <TextBlock Text="Adresse" Style="{StaticResource DialogHintStyle}" Margin="0,14,0,6"/>
        <TextBox x:Name="UrlBox" TextChanged="UrlBox_TextChanged"/>
        <TextBlock Text="Par exemple https://pve.lan:8006 ou http://192.168.1.20:8096"
                   Style="{StaticResource DialogHintStyle}"
                   FontSize="11.5"
                   Margin="0,4,0,0"/>

        <TextBlock Text="Groupe (facultatif)" Style="{StaticResource DialogHintStyle}" Margin="0,14,0,6"/>
        <ComboBox x:Name="GroupBox" IsEditable="True"/>

        <CheckBox x:Name="MonitorBox" IsChecked="True" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Surveiller ce service"/>
                <TextBlock Text="Son état s’affiche sur la page d’accueil et une notification prévient s’il ne répond plus."
                           Style="{StaticResource DialogHintStyle}"/>
            </StackPanel>
        </CheckBox>

        <TextBlock x:Name="ErrorText"
                   Margin="0,12,0,0"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <StackPanel Style="{StaticResource DialogButtonBarStyle}">
            <Button Content="Annuler" Command="ApplicationCommands.Close" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</controles:DialogWindow>
