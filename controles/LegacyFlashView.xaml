<UserControl x:Class="MyHomelabBrowser.controles.LegacyFlashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Border Background="#DD141414"
                CornerRadius="18"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="520">

            <StackPanel>
                <TextBlock Text="⚡ Mode Legacy (Flash réel)"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="UrlText"
                           Margin="0,8,0,0"
                           Foreground="#D0D0D0"
                           FontSize="13"/>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <TextBlock x:Name="Spinner"
                               Text="⏳"
                               Foreground="White"
                               FontSize="18"
                               Margin="0,0,10,0"/>

                    <TextBlock x:Name="StatusText"
                               Text="Lancement de Basilisk…"
                               Foreground="White"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText"
                           Margin="0,12,0,0"
                           Foreground="#FF6B6B"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button x:Name="RetryBtn"
                            Content="Retenter Basilisk"
                            Padding="12,6"
                            Margin="0,0,8,0"/>

                    <Button x:Name="SettingsBtn"
                            Content="Paramètres"
                            Padding="12,6"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
