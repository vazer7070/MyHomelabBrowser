<UserControl x:Class="MyHomelabBrowser.controles.ReportIssueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource FluentBg}">

    <UserControl.Resources>

        <!-- ===================== -->
        <!-- Labels -->
        <!-- ===================== -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>

        <!-- ===================== -->
        <!-- TextBox -->
        <!-- ===================== -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ===================== -->
        <!-- ComboBox Fluent++ -->
        <!-- ===================== -->
        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>

                            <!-- Main box -->
                            <Border x:Name="Border"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6"/>

                            <!-- Click handler -->
                            <ToggleButton x:Name="Toggle"
              Background="Transparent"
              BorderThickness="0"
              OverridesDefaultStyle="True"
              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
              Focusable="False"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <!-- zone cliquable invisible -->
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                            </ToggleButton>

                            <!-- Selected item -->
                            <ContentPresenter
        Margin="10,0,36,0"
        VerticalAlignment="Center"
        HorizontalAlignment="Left"
        Content="{TemplateBinding SelectionBoxItem}"/>

                            <!-- Arrow -->
                            <TextBlock Text="▾"
               FontSize="14"
               Foreground="#CCCCCC"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Margin="0,0,12,0"/>

                            <!-- Popup -->
                            <Popup x:Name="Popup"
           Placement="Bottom"
           IsOpen="{TemplateBinding IsDropDownOpen}"
           AllowsTransparency="True"
           Focusable="False"
           PopupAnimation="None">

                                <Border x:Name="DropDownBorder"
                Background="#2B2B2B"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4"
                Opacity="0"
                RenderTransformOrigin="0.5,0">

                                    <Border.RenderTransform>
                                        <TranslateTransform Y="-6"/>
                                    </Border.RenderTransform>

                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger SourceName="Toggle" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
            Property="BorderBrush"
            Value="#5A5A5A"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#7A7A7A"/>
                            </Trigger>

                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>

                                            <DoubleAnimation
                                                Storyboard.TargetName="DropDownBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                From="0" To="1"
                                                Duration="0:0:0.12"/>

                                            <DoubleAnimation
                                                Storyboard.TargetName="DropDownBorder"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                From="-6" To="0"
                                                Duration="0:0:0.12"/>

                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Background" Value="#2B2B2B"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="#3A3A3A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#505050"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== -->
        <!-- Buttons -->
        <!-- ===================== -->
        <Style x:Key="FormButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#606060"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🐞 Signaler un problème"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,24"/>

        <StackPanel Grid.Row="1">

            <TextBlock Text="Titre" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="TitleBox"
                     Style="{StaticResource FormTextBox}"/>

            <TextBlock Text="Type" Style="{StaticResource FormLabel}"/>
            <ComboBox x:Name="TypeBox"
                      Style="{StaticResource FormComboBox}">
                <ComboBoxItem Content="🐞 Bug / dysfonctionnement" Tag="Bug"/>
                <ComboBoxItem Content="✨ Fonctionnalité manquante" Tag="MissingFeature"/>
                <ComboBoxItem Content="➕ Demande d'ajout" Tag="FeatureRequest"/>
                <ComboBoxItem Content="🎨 UX / UI" Tag="UiUx"/>
                <ComboBoxItem Content="⚡ Performance" Tag="Performance"/>
                <ComboBoxItem Content="❓ Autre" Tag="Other"/>
            </ComboBox>

            <TextBlock Text="Description" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="DescriptionBox"
                     Style="{StaticResource FormTextBox}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="200"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">

            <Button Content="Annuler"
                    Style="{StaticResource FormButton}"
                    Margin="0,0,12,0"
                    Click="Cancel_Click"/>

            <Button x:Name="SendButton"
                    Content="Envoyer"
                    Style="{StaticResource FormButton}"
                    Background="#B03030"
                    Click="Send_Click"/>
        </StackPanel>

        <StackPanel x:Name="SendingPanel"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,72,0,0"
                    Visibility="Collapsed">

            <ProgressBar Width="70"
                         Height="6"
                         IsIndeterminate="True"
                         VerticalAlignment="Center"/>

            <TextBlock Text="Envoi en cours…"
                       Foreground="#AAAAAA"
                       FontSize="13"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>

    </Grid>
</UserControl>