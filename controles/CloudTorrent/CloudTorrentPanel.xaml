<UserControl x:Class="MyHomelabBrowser.controles.CloudTorrent.CloudTorrentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="410"
             MaxWidth="460"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="PanelIconButton" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="CompactActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="13,7"/>
        </Style>

        <Style x:Key="CloudTorrentComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloudTorrentComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MaxDropDownHeight" Value="290"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CloudTorrentComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"/>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          OverridesDefaultStyle="True"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="12,0,38,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <Path Width="10"
                                  Height="6"
                                  Margin="0,0,13,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Stretch="Fill"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Data="M0,0 L5,5 L10,0 Z"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,5,0,0"
                                        Padding="5"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="18,15"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="38" Height="38"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="11">
                        <Grid>
                            <Path Width="20" Height="20"
                                  Stretch="Uniform"
                                  Fill="{StaticResource AccentBrush}"
                                  Data="M4,3 L15,3 C17.8,3 20,5.2 20,8 C20,10.8 17.8,13 15,13 L13,13 L13,17 L16,14 L18,16 L12,22 L6,16 L8,14 L11,17 L11,13 L9,13 C6.2,13 4,10.8 4,8 Z M9,6 C7.9,6 7,6.9 7,8 C7,9.1 7.9,10 9,10 L15,10 C16.1,10 17,9.1 17,8 C17,6.9 16.1,6 15,6 Z"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="CloudTorrent"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="HeaderStatusText"
                                   Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Module inactif"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="OpenSiteButton"
                                Style="{StaticResource PanelIconButton}"
                                Content="↗"
                                ToolTip="Ouvrir CloudTorrent"
                                Click="OpenSiteButton_Click"/>
                        <Button Margin="6,0,0,0"
                                Style="{StaticResource PanelIconButton}"
                                Content="⚙"
                                ToolTip="Paramètres CloudTorrent"
                                Click="SettingsButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          MaxHeight="650"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14">
                    <Border x:Name="UnavailableCard"
                            Style="{StaticResource ModernCardStyle}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="UnavailableTitle"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="UnavailableMessage"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Ouvrir les paramètres"
                                    Click="SettingsButton_Click"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ActiveContent">
                        <Border Style="{StaticResource ModernCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ModuleStatusDot"
                                                 Width="8" Height="8"
                                                 Fill="{StaticResource SuccessBrush}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AccountText"
                                                   Margin="8,0,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ActivityText"
                                               Margin="16,5,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Padding="9,4"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="8"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="ApiVersionText"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="PageTitleText"
                                                   Text="Aucune page analysée"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="PageMetaText"
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button x:Name="RefreshDetectionButton"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Style="{StaticResource PanelIconButton}"
                                            Content="⟳"
                                            ToolTip="Analyser de nouveau"
                                            Click="AnalyzePageButton_Click"/>
                                </Grid>

                                <TextBlock x:Name="PageUrlText"
                                           Margin="0,10,0,0"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextTertiaryBrush}"/>

                                <StackPanel Margin="0,13,0,0" Orientation="Horizontal">
                                    <Button x:Name="AnalyzePageButton"
                                            Style="{StaticResource CompactActionButton}"
                                            Content="Détecter les sources"
                                            Click="AnalyzePageButton_Click"/>
                                    <Button x:Name="ServerAnalyzeButton"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource CompactActionButton}"
                                            Content="Analyser la vidéo"
                                            Click="ServerAnalyzeButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Éléments détectés"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="SelectionSummaryText"
                                                   Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource TextButtonStyle}"
                                            Content="Tout sélectionner"
                                            Click="SelectAllButton_Click"/>
                                </Grid>

                                <ItemsControl x:Name="DetectedItemsControl" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,7"
                                                    Padding="10"
                                                    Background="{StaticResource SurfaceRaisedBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              Margin="0,0,9,0"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Click="DetectedItemCheckBox_Click"/>

                                                    <Border Grid.Column="1"
                                                            Width="28" Height="28"
                                                            Margin="0,0,9,0"
                                                            Background="{StaticResource AccentSoftBrush}"
                                                            CornerRadius="8">
                                                        <TextBlock Text="{Binding Icon}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontWeight="Bold"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Url}"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="3"
                                                            Margin="8,0,0,0"
                                                            Padding="7,3"
                                                            Background="{StaticResource SurfaceHoverBrush}"
                                                            CornerRadius="7"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeLabel}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="NoDetectionText"
                                           Margin="0,8,0,0"
                                           Text="Aucun élément n’a encore été détecté."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ServerAnalysisCard"
                                Margin="0,10,0,0"
                                Style="{StaticResource ModernCardStyle}"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Résultat de l’analyse"
                                           FontSize="12"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="ServerAnalysisTitleText"
                                           Margin="0,4,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="ServerAnalysisMetaText"
                                           Margin="0,5,0,12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="Qualité"
                                           Margin="0,0,0,6"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="QualityComboBox"
                                          Style="{StaticResource CloudTorrentComboBoxStyle}"
                                          DisplayMemberPath="Label"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Style="{StaticResource ModernCardStyle}">
                            <StackPanel>
                                <Button x:Name="QueueSelectedButton"
                                        Height="42"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Envoyer la sélection vers CloudTorrent"
                                        Click="QueueSelectedButton_Click"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="BusyProgress"
                                                 Width="80" Height="3"
                                                 IsIndeterminate="True"
                                                 Visibility="Collapsed"/>
                                    <TextBlock x:Name="FooterStatusText"
                                               Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
