<UserControl x:Class="MyHomelabBrowser.controles.BrowserTabHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="34"
             MinWidth="0"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="Transparent"
             MouseEnter="Header_MouseEnter"
             MouseLeave="Header_MouseLeave"
             MouseLeftButtonDown="Header_MouseLeftButtonDown"
             MouseLeftButtonUp="Header_MouseLeftButtonUp"
             MouseDown="Header_MouseDown"
             PreviewMouseMove="Header_MouseMove">

    <UserControl.Resources>
        <!-- Bouton rond discret utilisé pour épingler / fermer. -->
        <Style x:Key="TabActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfacePressedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource BorderStrongBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Root"
            Background="Transparent"
            Padding="10,0,6,0"
            SnapsToDevicePixels="True">

        <Border.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="GhostOffset"/>
                <TranslateTransform x:Name="ReorderOffset"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid x:Name="HeaderGrid" VerticalAlignment="Center">

            <!-- Contenu normal de l'onglet -->
            <Grid x:Name="NormalLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Favicon, globe par défaut ou indicateur de chargement -->
                <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path x:Name="DefaultIcon"
                          Stretch="Uniform"
                          Fill="{StaticResource TextTertiaryBrush}"
                          Data="M12,2 A10,10 0 1 0 12.01,2 Z M12,4 C12.9,4 14.1,5.6 14.7,8 L9.3,8 C9.9,5.6 11.1,4 12,4 Z M8.9,4.6 C8.3,5.5 7.8,6.7 7.5,8 L5.3,8 C6.1,6.5 7.4,5.3 8.9,4.6 Z M15.1,4.6 C16.6,5.3 17.9,6.5 18.7,8 L16.5,8 C16.2,6.7 15.7,5.5 15.1,4.6 Z M4.4,10 L7.2,10 C7.1,10.7 7.1,11.3 7.1,12 C7.1,12.7 7.1,13.3 7.2,14 L4.4,14 C4.2,13.4 4.1,12.7 4.1,12 C4.1,11.3 4.2,10.6 4.4,10 Z M9.2,10 L14.8,10 C14.9,10.7 14.9,11.3 14.9,12 C14.9,12.7 14.9,13.3 14.8,14 L9.2,14 C9.1,13.3 9.1,12.7 9.1,12 C9.1,11.3 9.1,10.7 9.2,10 Z M16.8,10 L19.6,10 C19.8,10.6 19.9,11.3 19.9,12 C19.9,12.7 19.8,13.4 19.6,14 L16.8,14 C16.9,13.3 16.9,12.7 16.9,12 C16.9,11.3 16.9,10.7 16.8,10 Z M5.3,16 L7.5,16 C7.8,17.3 8.3,18.5 8.9,19.4 C7.4,18.7 6.1,17.5 5.3,16 Z M9.3,16 L14.7,16 C14.1,18.4 12.9,20 12,20 C11.1,20 9.9,18.4 9.3,16 Z M16.5,16 L18.7,16 C17.9,17.5 16.6,18.7 15.1,19.4 C15.7,18.5 16.2,17.3 16.5,16 Z"/>
                    <Image x:Name="Icon"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="Collapsed"/>
                    <Path x:Name="LoadingSpinner"
                          Width="16" Height="16"
                          Stretch="None"
                          Stroke="{StaticResource AccentBrush}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5"
                          Visibility="Collapsed"
                          Data="M8,1.5 A6.5,6.5 0 1 1 1.5,8">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>

                <DockPanel Grid.Column="1" VerticalAlignment="Center" LastChildFill="True">
                    <!-- Marqueur navigation privée -->
                    <Border x:Name="PrivateBadge"
                            DockPanel.Dock="Left"
                            Visibility="Collapsed"
                            Background="{StaticResource PrivateSoftBrush}"
                            CornerRadius="4"
                            Padding="5,1"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Privé"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrivateBrush}"/>
                    </Border>

                    <TextBlock x:Name="Title"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12.5"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,4,0"/>
                </DockPanel>

                <Button x:Name="PinBtn"
                        Grid.Column="2"
                        Style="{StaticResource TabActionButtonStyle}"
                        Visibility="Collapsed"
                        ToolTip="Épingler l’onglet">
                    <Viewbox Width="11" Height="11">
                        <Path Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              Data="M7.2,1.5 L16.8,1.5 C17.5,1.5 18,2 18,2.7 C18,3.1 17.8,3.5 17.5,3.8 L15.9,5.4 L16.8,10.4 L19.2,12.8 C19.6,13.2 19.7,13.8 19.5,14.3 C19.3,14.8 18.8,15.1 18.2,15.1 L13.2,15.1 L13.2,21.5 C13.2,22.2 12.7,22.7 12,22.7 C11.3,22.7 10.8,22.2 10.8,21.5 L10.8,15.1 L5.8,15.1 C5.2,15.1 4.7,14.8 4.5,14.3 C4.3,13.8 4.4,13.2 4.8,12.8 L7.2,10.4 L8.1,5.4 L6.5,3.8 C6.2,3.5 6,3.1 6,2.7 C6,2 6.5,1.5 7.2,1.5 Z M10.3,4.1 L9.2,5.2 L8.1,11.4 L7,12.6 L17,12.6 L15.9,11.4 L14.8,5.2 L13.7,4.1 Z"/>
                    </Viewbox>
                </Button>

                <Button x:Name="CloseBtn"
                        Grid.Column="3"
                        Style="{StaticResource TabActionButtonStyle}"
                        Margin="2,0,0,0"
                        ToolTip="Fermer l’onglet (Ctrl+W)">
                    <Viewbox Width="9" Height="9">
                        <Path Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M2,2 L14,14 M14,2 L2,14"/>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- Mode épinglé : favicon seul, centré -->
            <Grid x:Name="PinnedLayout" Visibility="Collapsed">
                <Grid x:Name="PinnedFaviconHost"
                      Width="16" Height="16"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Path x:Name="PinnedDefaultIcon"
                          Stretch="Uniform"
                          Fill="{StaticResource TextTertiaryBrush}"
                          Data="{Binding Data, ElementName=DefaultIcon}"/>
                    <Image x:Name="PinnedIcon"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="Collapsed"/>
                </Grid>

                <!-- Discret au repos, devient le bouton de désépinglage au survol -->
                <Button x:Name="PinnedUnpinBtn"
                        Style="{StaticResource TabActionButtonStyle}"
                        Width="22" Height="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Foreground="{StaticResource AccentBrush}"
                        ToolTip="Désépingler l’onglet">
                    <Viewbox Width="11" Height="11">
                        <Path Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              Data="M7.2,1.5 L16.8,1.5 C17.5,1.5 18,2 18,2.7 C18,3.1 17.8,3.5 17.5,3.8 L15.9,5.4 L16.8,10.4 L19.2,12.8 C19.6,13.2 19.7,13.8 19.5,14.3 C19.3,14.8 18.8,15.1 18.2,15.1 L13.2,15.1 L13.2,21.5 C13.2,22.2 12.7,22.7 12,22.7 C11.3,22.7 10.8,22.2 10.8,21.5 L10.8,15.1 L5.8,15.1 C5.2,15.1 4.7,14.8 4.5,14.3 C4.3,13.8 4.4,13.2 4.8,12.8 L7.2,10.4 L8.1,5.4 L6.5,3.8 C6.2,3.5 6,3.1 6,2.7 C6,2 6.5,1.5 7.2,1.5 Z M10.3,4.1 L9.2,5.2 L8.1,11.4 L7,12.6 L17,12.6 L15.9,11.4 L14.8,5.2 L13.7,4.1 Z"/>
                    </Viewbox>
                </Button>

                <!-- Petit repère permanent de l'onglet épinglé -->
                <Border x:Name="PinnedMarker"
                        Width="4" Height="4"
                        CornerRadius="2"
                        Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,5"
                        IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
