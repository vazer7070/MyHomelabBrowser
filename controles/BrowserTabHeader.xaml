<UserControl x:Class="MyHomelabBrowser.controles.BrowserTabHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32"
             MinWidth="0"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             MouseEnter="Header_MouseEnter"
             MouseLeave="Header_MouseLeave"
             MouseLeftButtonDown="Header_MouseLeftButtonDown"
             MouseLeftButtonUp="Header_MouseLeftButtonUp"
             PreviewMouseMove="Header_MouseMove">

    <Border x:Name="Root"
            Background="Transparent"
            CornerRadius="9"
            Padding="8,0"
            SnapsToDevicePixels="True">

        <Border.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="GhostOffset"/>
                <TranslateTransform x:Name="ReorderOffset"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid x:Name="HeaderGrid"
              VerticalAlignment="Center"
              ClipToBounds="False">

            <!-- Contenu normal de l'onglet -->
            <Grid x:Name="NormalLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="IconColumn" Width="Auto"/>
                    <ColumnDefinition x:Name="TitleColumn" Width="*"/>
                    <ColumnDefinition x:Name="PinColumn" Width="22"/>
                    <ColumnDefinition x:Name="CloseColumn" Width="22"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="FaviconHost"
                        Grid.Column="0"
                        Width="22"
                        Height="22"
                        Margin="0,0,6,0"
                        CornerRadius="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ClipToBounds="True">
                    <Image x:Name="Icon"
                           Stretch="UniformToFill"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"/>
                </Border>

                <TextBlock x:Name="Title"
                           Grid.Column="1"
                           Foreground="White"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,6,0"/>

                <!-- Épinglage normal : l'action et le nom restent inchangés -->
                <Button x:Name="PinBtn"
                        Grid.Column="2"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Padding="0"
                        Cursor="Hand"
                        ToolTip="Épingler l’onglet">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface"
                                    Width="20"
                                    Height="20"
                                    Background="Transparent"
                                    CornerRadius="5">
                                <Viewbox Width="12"
                                         Height="12"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Path Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          Data="M7.2,1.5 L16.8,1.5 C17.5,1.5 18,2 18,2.7 C18,3.1 17.8,3.5 17.5,3.8 L15.9,5.4 L16.8,10.4 L19.2,12.8 C19.6,13.2 19.7,13.8 19.5,14.3 C19.3,14.8 18.8,15.1 18.2,15.1 L13.2,15.1 L13.2,21.5 C13.2,22.2 12.7,22.7 12,22.7 C11.3,22.7 10.8,22.2 10.8,21.5 L10.8,15.1 L5.8,15.1 C5.2,15.1 4.7,14.8 4.5,14.3 C4.3,13.8 4.4,13.2 4.8,12.8 L7.2,10.4 L8.1,5.4 L6.5,3.8 C6.2,3.5 6,3.1 6,2.7 C6,2 6.5,1.5 7.2,1.5 Z M10.3,4.1 L9.2,5.2 L8.1,11.4 L7,12.6 L17,12.6 L15.9,11.4 L14.8,5.2 L13.7,4.1 Z"/>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#27374A"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#344B66"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="CloseBtn"
                        Grid.Column="3"
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Cursor="Hand"
                        ToolTip="Fermer l’onglet"
                        Content="✕">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Surface"
                                                Background="Transparent"
                                                CornerRadius="9">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="#402020"/>
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Mode épinglé : favicon seul, parfaitement centré -->
            <Grid x:Name="PinnedLayout"
                  Visibility="Collapsed"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <Border x:Name="PinnedFaviconHost"
                        Width="22"
                        Height="22"
                        CornerRadius="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ClipToBounds="True">
                    <Image x:Name="PinnedIcon"
                           Stretch="UniformToFill"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"/>
                </Border>

                <!-- Discret au repos, devient le bouton de désépinglage au survol -->
                <Button x:Name="PinnedUnpinBtn"
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#D91B2430"
                        BorderBrush="#604EA2FF"
                        BorderThickness="1"
                        Foreground="{StaticResource AccentBrush}"
                        Padding="0"
                        Cursor="Hand"
                        Opacity="0"
                        IsHitTestVisible="False"
                        ToolTip="Désépingler l’onglet">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Viewbox Width="12"
                                         Height="12"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Path Stretch="Uniform"
                                          Fill="{TemplateBinding Foreground}"
                                          Data="M7.2,1.5 L16.8,1.5 C17.5,1.5 18,2 18,2.7 C18,3.1 17.8,3.5 17.5,3.8 L15.9,5.4 L16.8,10.4 L19.2,12.8 C19.6,13.2 19.7,13.8 19.5,14.3 C19.3,14.8 18.8,15.1 18.2,15.1 L13.2,15.1 L13.2,21.5 C13.2,22.2 12.7,22.7 12,22.7 C11.3,22.7 10.8,22.2 10.8,21.5 L10.8,15.1 L5.8,15.1 C5.2,15.1 4.7,14.8 4.5,14.3 C4.3,13.8 4.4,13.2 4.8,12.8 L7.2,10.4 L8.1,5.4 L6.5,3.8 C6.2,3.5 6,3.1 6,2.7 C6,2 6.5,1.5 7.2,1.5 Z M10.3,4.1 L9.2,5.2 L8.1,11.4 L7,12.6 L17,12.6 L15.9,11.4 L14.8,5.2 L13.7,4.1 Z"/>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#F02A3C52"/>
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#FF344B66"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Petit repère permanent, sans ajouter une grosse punaise -->
                <Border x:Name="PinnedMarker"
                        Width="4"
                        Height="4"
                        CornerRadius="2"
                        Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,3,3"
                        IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
