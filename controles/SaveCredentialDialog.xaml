<Window x:Class="MyHomelabBrowser.controles.SaveCredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enregistrer le mot de passe"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent">

    <Border Background="#1E1E1E"
            BorderBrush="#2D2D2D"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24"
            Width="420">

        <StackPanel>

            <!-- HEADER -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,18">
                <Border Width="36"
                        Height="36"
                        CornerRadius="18"
                        Background="#2563EB"
                        Margin="0,0,12,0">
                    <TextBlock Text="🔐"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Enregistrer ce mot de passe ?"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- SITE -->
            <TextBlock Text="Site"
                       Foreground="#9CA3AF"
                       FontSize="12"/>

            <TextBlock Text="{Binding Host}"
                       Foreground="White"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,2,0,12"/>

            <!-- USER -->
            <TextBlock Text="Identifiant"
                       Foreground="#9CA3AF"
                       FontSize="12"/>

            <TextBlock Text="{Binding Username}"
                       Foreground="White"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,2,0,18"/>

            <!-- CHECKBOX -->
            <CheckBox x:Name="AlwaysSaveCheckBox"
                      Content="Toujours enregistrer pour ce site"
                      Foreground="White"
                      FontSize="13"
                      Margin="0,0,0,22"/>

            <!-- ACTIONS -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Non"
                        Width="120"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="#2A2A2A"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="No_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Oui, enregistrer"
                        Width="160"
                        Height="40"
                        Background="#0078D4"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Yes_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

        </StackPanel>
    </Border>
</Window>
