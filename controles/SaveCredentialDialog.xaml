<Window x:Class="MyHomelabBrowser.controles.SaveCredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enregistrer le mot de passe"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Style local : ne dépend pas du template global des CheckBox. -->
        <Style x:Key="CredentialPromptCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="HitArea"
                              Background="Transparent"
                              MinHeight="34"
                              SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#FF181D26"
                                    BorderBrush="#FF788395"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Path x:Name="CheckMark"
                                      Width="10"
                                      Height="8"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M1,4 L4,7 L9,1"
                                      Visibility="Collapsed"/>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{StaticResource AccentStrongBrush}"/>
                                <Setter TargetName="Box" Property="Background"
                                        Value="#FF202A38"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{StaticResource AccentStrongBrush}"/>
                                <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background"
                                        Value="{StaticResource AccentStrongBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{StaticResource AccentStrongBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HitArea" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24">

        <Border.Effect>
            <DropShadowEffect BlurRadius="26"
                              ShadowDepth="8"
                              Opacity="0.38"
                              Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border Width="36"
                        Height="36"
                        CornerRadius="18"
                        Background="{StaticResource AccentStrongBrush}"
                        Margin="0,0,12,0">
                    <Viewbox Width="18"
                             Height="18"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Path Fill="White"
                              Data="M12,2 C8.7,2 6,4.7 6,8 V10 H5 C3.9,10 3,10.9 3,12 V20 C3,21.1 3.9,22 5,22 H19 C20.1,22 21,21.1 21,20 V12 C21,10.9 20.1,10 19,10 H18 V8 C18,4.7 15.3,2 12,2 Z M12,4 C14.2,4 16,5.8 16,8 V10 H8 V8 C8,5.8 9.8,4 12,4 Z M12,14 C13.1,14 14,14.9 14,16 C14,16.7 13.6,17.4 13,17.7 V20 H11 V17.7 C10.4,17.4 10,16.7 10,16 C10,14.9 10.9,14 12,14 Z"/>
                    </Viewbox>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Enregistrer ce mot de passe ?"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="Le mot de passe reste chiffré dans le profil actuel."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Site"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Host}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Row="1"
                               Text="Identifiant"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding Username}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <CheckBox x:Name="AlwaysSaveCheckBox"
                      Style="{StaticResource CredentialPromptCheckBoxStyle}"
                      Content="Mettre automatiquement à jour cet identifiant sur cette origine"
                      Margin="0,2,0,14"
                      ToolTip="Les prochaines modifications de ce mot de passe seront enregistrées sans redemander."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Jamais pour ce site"
                        MinWidth="142"
                        Height="40"
                        Style="{StaticResource TextButtonStyle}"
                        Foreground="{StaticResource DangerBrush}"
                        Click="NeverSave_Click"/>

                <Button Grid.Column="2"
                        Content="Plus tard"
                        MinWidth="104"
                        Height="40"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="NotNow_Click"/>

                <Button Grid.Column="3"
                        Content="Enregistrer"
                        MinWidth="128"
                        Height="40"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="Save_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
