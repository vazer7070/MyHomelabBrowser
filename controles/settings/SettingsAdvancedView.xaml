<UserControl x:Class="MyHomelabBrowser.controles.settings.SettingsAdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720">

            <TextBlock Text="⚠ Paramètres avancés"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <TextBlock Text="Options techniques réservées aux utilisateurs avancés."
                       Foreground="{StaticResource WarningBrush}"
                       Margin="0,6,0,20"/>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>

                    <TextBlock Text="Compatibilité Flash"
                               Style="{StaticResource SettingsTitle}"/>

                    <CheckBox x:Name="EnableFlashSupportBox"
                              Content="Activer le moteur Flash intégré"
                              IsChecked="{Binding EnableFlashSupport}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,6"/>

                    <CheckBox x:Name="PreferRuffleBox"
                              Content="Ruffle intégré est toujours essayé avant le moteur Legacy"
                              IsChecked="True"
                              IsEnabled="False"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,4"/>

                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="12"
                            Margin="0,10,0,8">
                        <StackPanel>
                            <TextBlock Text="Moteur Ruffle"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="RuffleRuntimeStatusText"
                                       Text="Vérification du moteur intégré…"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="FlashDebugEnabledBox"
                              Content="Mode debug Flash (logs / overlay)"
                              IsChecked="{Binding FlashDebugEnabled}"
                              IsEnabled="{Binding EnableFlashSupport}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,4"/>

                    <Button x:Name="OpenFlashConsoleBtn"
                            Content="Ouvrir console Flash"
                            Padding="16,6"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"/>

                    <TextBlock Text="Moteur de secours Legacy (Basilisk)"
                               Style="{StaticResource SettingsLabel}"
                               Margin="0,16,0,6"/>

                    <StackPanel Orientation="Horizontal"
                                IsEnabled="{Binding EnableFlashSupport}">
                        <TextBox x:Name="BasiliskPathBox"
                                 Height="36"
                                 Width="460"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"
                                 Text="{Binding BasiliskPath}"/>

                        <Button x:Name="PickBasiliskPathBtn"
                                Content="Parcourir…"
                                Margin="10,0,0,0"
                                Padding="16,6"/>
                    </StackPanel>

                    <TextBlock Text="En mode automatique, PommeBrowser tente Ruffle avec les paramètres du lecteur d’origine. Le moteur Legacy n’est utilisé automatiquement que si ce même contenu a échoué plusieurs fois avec Ruffle et a déjà fonctionné avec Basilisk."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>

                    <Separator Margin="0,18,0,12"/>

                    <TextBlock Text="Exceptions forcées en mode Legacy"
                               Style="{StaticResource SettingsLabel}"/>

                    <TextBlock Text="Ces règles sont facultatives. Sans règle, la compatibilité est apprise par contenu SWF et non par nom de site."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <ListBox x:Name="FlashLegacyList"
                             Height="140"
                             Background="{StaticResource SurfaceRaisedBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderThickness="0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="AddFlashRuleBtn"
                                Content="Ajouter"
                                Padding="14,6"
                                Margin="0,0,10,0"/>

                        <Button x:Name="RemoveFlashRuleBtn"
                                Content="Supprimer"
                                Padding="14,6"
                                Margin="0,0,10,0"/>

                        <Button x:Name="ClearFlashCompatibilityBtn"
                                Content="Réinitialiser l’apprentissage"
                                Padding="14,6"
                                ToolTip="Efface les préférences Ruffle/Legacy apprises pour ce profil"/>
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
