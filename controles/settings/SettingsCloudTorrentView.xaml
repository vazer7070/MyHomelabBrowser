<UserControl x:Class="MyHomelabBrowser.controles.settings.SettingsCloudTorrentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,12,30">
        <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" Background="{StaticResource AccentSoftBrush}" CornerRadius="14">
                    <Path Width="26" Height="26" Stretch="Uniform" Fill="{StaticResource AccentBrush}"
                          Data="M4,3 L15,3 C17.8,3 20,5.2 20,8 C20,10.8 17.8,13 15,13 L13,13 L13,17 L16,14 L18,16 L12,22 L6,16 L8,14 L11,17 L11,13 L9,13 C6.2,13 4,10.8 4,8 Z M9,6 C7.9,6 7,6.9 7,8 C7,9.1 7.9,10 9,10 L15,10 C16.1,10 17,9.1 17,8 C17,6.9 16.1,6 15,6 Z"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CloudTorrent" Foreground="{StaticResource TextPrimaryBrush}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"
                               Text="Connecte ce profil du navigateur à ton débrideur. Le module ne s’active qu’après validation réelle de l’adresse et de la clé API."/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource ModernCardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Connexion" Style="{StaticResource SettingsTitle}"/>

                    <TextBlock Text="Adresse du site" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,3,0,8" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"
                               Text="Exemple : https://debrideur.maloquine.us"/>
                    <TextBox x:Name="ServerUrlBox"
                             Height="44"
                             MinHeight="44"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             SpellCheck.IsEnabled="False"/>

                    <TextBlock Margin="0,18,0,0" Text="Clé API" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,3,0,8" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"
                               Text="Laisse le champ vide pour conserver la clé chiffrée déjà enregistrée."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                     Grid.Column="0"
                                     Height="44"
                                     MinHeight="44"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"/>
                        <TextBox x:Name="ApiKeyTextBox"
                                 Grid.Column="0"
                                 Height="44"
                                 MinHeight="44"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Visibility="Collapsed"
                                 SpellCheck.IsEnabled="False"/>
                        <Button x:Name="ToggleKeyButton" Grid.Column="1" Margin="8,0,0,0" MinWidth="88" Height="42"
                                Style="{StaticResource SecondaryButtonStyle}" Content="Afficher" Click="ToggleKeyButton_Click"/>
                    </Grid>
                    <TextBlock x:Name="StoredKeyLabel" Margin="0,7,0,0" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"/>

                    <Border Margin="0,18,0,0" Padding="14" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10">
                        <StackPanel>
                            <CheckBox x:Name="AutoAnalyzeCheckBox" IsChecked="True">
                                <TextBlock Text="Analyser automatiquement les pages compatibles"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </CheckBox>
                            <TextBlock Margin="24,4,0,0" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" TextWrapping="Wrap"
                                       Text="Détection après navigation, changement dynamique du contenu et lecture d’un média. L’analyse manuelle reste disponible dans le clic droit et depuis le bouton de la barre d’adresse."/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                        <Button x:Name="ConnectButton" MinWidth="190" Height="42" Style="{StaticResource PrimaryButtonStyle}"
                                Content="Tester et enregistrer" Click="ConnectButton_Click"/>
                        <Button x:Name="DisconnectButton" MinWidth="120" Height="42" Margin="10,0,0,0"
                                Style="{StaticResource DangerButtonStyle}" Content="Déconnecter" Click="DisconnectButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="StatusBorder" Margin="0,14,0,0" Style="{StaticResource ModernCardStyle}" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="StatusDot" Width="10" Height="10" Margin="0,4,12,0" VerticalAlignment="Top" CornerRadius="5" Background="#747474"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatusTitle" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="15" Text="Non configuré"/>
                        <TextBlock x:Name="StatusMessage" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="AccountCard" Margin="0,14,0,0" Style="{StaticResource ModernCardStyle}" Padding="18" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Connexion active" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Margin="0,4,0,0" Text="La clé est validée pour ce profil du navigateur." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <Border Grid.Column="1" Padding="10,5" Background="#183D2A" CornerRadius="8" VerticalAlignment="Center">
                            <TextBlock Text="Module actif" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <UniformGrid Columns="2" Margin="0,16,0,0">
                        <Border Margin="0,0,6,8" Padding="13" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10">
                            <StackPanel><TextBlock Text="Utilisateur" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"/><TextBlock x:Name="AccountUsername" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/></StackPanel>
                        </Border>
                        <Border Margin="6,0,0,8" Padding="13" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10">
                            <StackPanel><TextBlock Text="Version API" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"/><TextBlock x:Name="AccountVersion" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/></StackPanel>
                        </Border>
                        <Border Margin="0,0,6,0" Padding="13" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10">
                            <StackPanel><TextBlock Text="Téléchargements actifs" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"/><TextBlock x:Name="AccountActiveJobs" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/></StackPanel>
                        </Border>
                        <Border Margin="6,0,0,0" Padding="13" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10">
                            <StackPanel><TextBlock Text="Quota" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"/><TextBlock x:Name="AccountQuota" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Margin="0,18,0,8" Text="Droits accordés à cette clé" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    <ItemsControl x:Name="PermissionsList">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,7,7" Padding="9,5" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"><TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
