<Window x:Class="MyHomelabBrowser.controles.settings.CertificateManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Certificats"
        Width="1120"
        Height="760"
        MinWidth="940"
        MinHeight="620"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="CertificateComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CertificateComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MaxDropDownHeight" Value="290"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CertificateComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"/>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          OverridesDefaultStyle="True"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,40,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Path Width="10"
                                  Height="6"
                                  Margin="0,0,14,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Stretch="Fill"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Data="M0,0 L5,5 L10,0 Z"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,5,0,0"
                                        Padding="5"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="DetailCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Grid.Row="0" Margin="24,20,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="46"
                        Height="46"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource AccentStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="13">
                    <TextBlock Text=""
                               FontFamily="{StaticResource IconFont}"
                               FontSize="21"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Certificats de confiance"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Autorités privées du profil et magasins Windows en lecture seule."
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Margin="0,0,8,0"
                        ToolTip="Recharger la liste"
                        Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text=""
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="Actualiser"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Click="ImportCertificate_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text=""
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="Ajouter à PommeBrowser"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource BorderBrush}"/>

        <!-- Contenu -->
        <Grid Grid.Row="2" Margin="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.92*" MinWidth="390"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.08*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- Liste -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="16,15,16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Autorités"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Certificates.Count, StringFormat={}{0} trouvée(s)}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="205"/>
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <TextBox x:Name="SearchBox"
                                         Padding="38,0,11,0"
                                         ToolTip="Rechercher par nom, émetteur ou empreinte"
                                         TextChanged="SearchBox_TextChanged"/>
                                <TextBlock Text=""
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="13,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>

                            <ComboBox x:Name="ScopeBox"
                                      Grid.Column="2"
                                      Style="{StaticResource CertificateComboBoxStyle}"
                                      SelectionChanged="ScopeBox_SelectionChanged">
                                <ComboBoxItem Content="PommeBrowser" Tag="Browser" IsSelected="True"/>
                                <ComboBoxItem Content="Windows · Utilisateur" Tag="User"/>
                                <ComboBoxItem Content="Windows · Ordinateur" Tag="Machine"/>
                                <ComboBoxItem Content="Tous les certificats" Tag="All"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource BorderBrush}"/>

                    <ListBox x:Name="CertificateList"
                             Grid.Row="2"
                             Margin="8"
                             ItemsSource="{Binding CertificatesView}"
                             SelectedItem="{Binding SelectedCertificate, Mode=TwoWay}"
                             SelectionChanged="CertificateList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="11">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentStrongBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="36"
                                            Height="36"
                                            Background="{StaticResource SurfaceRaisedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            VerticalAlignment="Top">
                                        <TextBlock Text=""
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="15"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding IssuerDisplay}"
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StoreDisplay}"
                                                   Margin="0,4,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3"
                                                Margin="12,0,0,0"
                                                HorizontalAlignment="Right">
                                        <Border Background="{StaticResource AccentSoftBrush}"
                                                CornerRadius="7"
                                                Padding="7,3"
                                                HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SourceBadge}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding ExpirationLabel}"
                                                   Margin="0,7,0,0"
                                                   HorizontalAlignment="Right"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Détails -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="17,15,17,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Détails du certificat"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Informations de confiance et de validité"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <Button x:Name="RemoveCertificateButton"
                                Grid.Column="1"
                                Content="Retirer du profil"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="Collapsed"
                                Click="RemoveCertificate_Click"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource BorderBrush}"/>

                    <Grid x:Name="EmptyDetails" Grid.Row="2">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="280">
                            <Border Width="58"
                                    Height="58"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    HorizontalAlignment="Center">
                                <TextBlock Text=""
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="25"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <TextBlock Text="Aucun certificat sélectionné"
                                       Margin="0,14,0,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Sélectionnez une autorité dans la liste pour consulter ses informations."
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="DetailsScroll"
                                  Grid.Row="2"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="17,16,17,18">
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedCertificate.DisplayName}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedCertificate.StoreDisplay}"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Padding="9,5"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="8"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding SelectedCertificate.ValidityLabel}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource DetailCard}">
                                <StackPanel>
                                    <TextBlock Text="SUJET" Style="{StaticResource DetailCaption}"/>
                                    <TextBlock Text="{Binding SelectedCertificate.Subject}" Style="{StaticResource DetailValue}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource DetailCard}">
                                <StackPanel>
                                    <TextBlock Text="ÉMETTEUR" Style="{StaticResource DetailCaption}"/>
                                    <TextBlock Text="{Binding SelectedCertificate.Issuer}" Style="{StaticResource DetailValue}"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DetailCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="VALIDITÉ" Style="{StaticResource DetailCaption}"/>
                                        <TextBlock Text="{Binding SelectedCertificate.ValidityPeriodDisplay}" Style="{StaticResource DetailValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource DetailCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="NUMÉRO DE SÉRIE" Style="{StaticResource DetailCaption}"/>
                                        <TextBlock Text="{Binding SelectedCertificate.SerialNumber}"
                                                   Style="{StaticResource DetailValue}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource DetailCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="EMPREINTE SHA-1" Style="{StaticResource DetailCaption}"/>
                                        <TextBlock Text="{Binding SelectedCertificate.Thumbprint}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Padding="10,5"
                                            MinHeight="30"
                                            VerticalAlignment="Center"
                                            Content="Copier"
                                            Click="CopyThumbprint_Click"/>
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DetailCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="SIGNATURE" Style="{StaticResource DetailCaption}"/>
                                        <TextBlock Text="{Binding SelectedCertificate.SignatureAlgorithm}" Style="{StaticResource DetailValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource DetailCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="CLÉ PUBLIQUE" Style="{StaticResource DetailCaption}"/>
                                        <TextBlock Text="{Binding SelectedCertificate.PublicKeyAlgorithm}" Style="{StaticResource DetailValue}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource BorderBrush}"/>

        <!-- Pied de fenêtre -->
        <Grid Grid.Row="4" Margin="24,14,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Les autorités ajoutées à PommeBrowser restent limitées au profil courant."
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="Les magasins Windows sont consultables ici, mais leur modification reste une action séparée."
                           Margin="0,3,0,0"
                           FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Ouvrir le gestionnaire Windows"
                        Margin="0,0,8,0"
                        Click="OpenWindowsCertificateManager_Click"/>
                <Button Content="Installer dans Windows…"
                        Click="InstallInWindows_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
