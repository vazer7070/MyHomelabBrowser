<UserControl x:Class="MyHomelabBrowser.controles.settings.SettingsUpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CONTENU PRINCIPAL ================= -->
            <Border Grid.Column="0"
                    Background="#1E1E1E"
                    CornerRadius="12"
                    Padding="28"
                    Margin="0,0,24,0">

                <StackPanel>

                    <!-- HEADER -->
                    <TextBlock Text="Mises à jour"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="État et gestion des mises à jour du navigateur"
                               Foreground="#A8A8A8"
                               FontSize="14"
                               Margin="0,6,0,28"/>

                    <!-- ================= INFOS VERSION ================= -->
                    <Border Background="#252525"
                            CornerRadius="10"
                            Padding="18"
                            Margin="0,0,0,20">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Version actuelle : "
                                           Foreground="#9A9A9A"/>
                                <TextBlock x:Name="CurrentVersionLabel"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Grid.Row="1">
                                <TextBlock Text="Dernière version : "
                                           Foreground="#9A9A9A"/>
                                <TextBlock x:Name="LatestVersionLabel"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ================= STATUT / PROGRESSION ================= -->
                    <TextBlock x:Name="UpdateStatusLabel"
                               Foreground="#AAAAAA"
                               Margin="0,0,0,10"/>

                    <ProgressBar x:Name="UpdateProgress"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 Visibility="Collapsed"/>

                    <TextBlock x:Name="UpdateProgressLabel"
                               Foreground="#AAAAAA"
                               Visibility="Collapsed"
                               Margin="0,6,0,20"/>

                    <!-- ================= ACTIONS ================= -->
                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="CheckUpdatesBtn"
                                Content="Vérifier les mises à jour"
                                Height="40"
                                Padding="18,0"
                                Background="#2A2A2A"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>

                        <Button x:Name="InstallUpdateBtn"
                                Content="Installer"
                                Height="40"
                                Padding="18,0"
                                Margin="10,0,0,0"
                                Background="#2A2A2A"
                                Foreground="White"
                                BorderThickness="0"
                                IsEnabled="False"
                                Cursor="Hand"/>

                        <Button x:Name="ChangelogBtn"
                                Content="Changelog"
                                Height="40"
                                Padding="18,0"
                                Margin="10,0,0,0"
                                Background="#2A2A2A"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ================= COLONNE RESPIRATION ================= -->
            <Border Grid.Column="1"
                    Background="#171717"
                    CornerRadius="12"/>

        </Grid>
    </ScrollViewer>
</UserControl>
