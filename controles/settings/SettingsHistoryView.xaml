<UserControl x:Class="MyHomelabBrowser.controles.settings.SettingsHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CONTENU ================= -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="12"
                    Padding="28"
                    Margin="0,0,24,0">

                <StackPanel>

                    <!-- HEADER -->
                    <TextBlock Text="Historique"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="Consulter et gérer l’historique de navigation"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"
                               Margin="0,6,0,28"/>

                    <!-- ACTION PRINCIPALE -->
                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            CornerRadius="10"
                            Padding="18">

                        <DockPanel LastChildFill="False">

                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Historique de navigation"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Accéder à la liste complète des pages visitées."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Button x:Name="OpenHistoryBtn"
                                    Content="📜 Ouvrir"
                                    Height="40"
                                    Padding="18,0"
                                    Margin="12,0,0,0"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    DockPanel.Dock="Right"/>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ================= PANNEAU DE RESPIRATION ================= -->
            <Border Grid.Column="1"
                    Background="{StaticResource WindowBackgroundBrush}"
                    CornerRadius="12"/>

        </Grid>
    </ScrollViewer>
</UserControl>
