<UserControl x:Class="MyHomelabBrowser.controles.settings.SettingsGeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="DnsComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DnsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DnsComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"/>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          OverridesDefaultStyle="True"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBlock Margin="12,0,42,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       IsHitTestVisible="False"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{Binding SelectedItem.Label,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                       TextTrimming="CharacterEllipsis"/>

                            <Path Width="10"
                                  Height="6"
                                  Margin="0,0,15,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Stretch="Fill"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Data="M0,0 L5,5 L10,0 Z"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,5,0,0"
                                        Padding="5"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,12,24">
            <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">

                <TextBlock Text="Général"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Text="Démarrage, nouveaux onglets, réseau et certificats du navigateur."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="14"
                           Margin="0,6,0,24"/>

                <!-- DÉMARRAGE -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="Démarrage du navigateur"
                                       Style="{StaticResource SettingsTitle}"
                                       Margin="0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <RadioButton Content="Ouvrir un onglet vide PommeBrowser"
                                     GroupName="StartupMode"
                                     Margin="0,4"
                                     IsChecked="{Binding Startup,
                                         Converter={StaticResource EnumEqualsConverter},
                                         ConverterParameter=EmptyTab}"/>

                        <RadioButton Content="Ouvrir une page personnalisée"
                                     GroupName="StartupMode"
                                     Margin="0,12,0,4"
                                     IsChecked="{Binding Startup,
                                         Converter={StaticResource EnumEqualsConverter},
                                         ConverterParameter=CustomPage}"/>

                        <TextBox Margin="24,4,0,0"
                                 Text="{Binding StartPage, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding Startup,
                                     Converter={StaticResource EnumEqualsConverter},
                                     ConverterParameter=CustomPage}"
                                 Opacity="{Binding Startup,
                                     Converter={StaticResource EnumOpacityConverter},
                                     ConverterParameter=CustomPage}"/>

                        <RadioButton Content="Restaurer les onglets de la session précédente"
                                     GroupName="StartupMode"
                                     Margin="0,16,0,0"
                                     IsChecked="{Binding Startup,
                                         Converter={StaticResource EnumEqualsConverter},
                                         ConverterParameter=RestoreSession}"/>

                        <TextBlock Text="Rouvre automatiquement les onglets WebView2 et Legacy de la session précédente."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="24,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- NOUVEAUX ONGLETS -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="Recherche et nouveaux onglets"
                                       Style="{StaticResource SettingsTitle}"
                                       Margin="0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Moteur utilisé par la barre d’adresse et la page d’accueil."
                                   Style="{StaticResource SettingsLabel}"
                                   Margin="0,0,0,7"/>

                        <ComboBox x:Name="SearchEngineBox"
                                  Style="{StaticResource DnsComboBoxStyle}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Page ouverte lors de la création d’un nouvel onglet classique (laisser vide pour la page d’accueil PommeBrowser)."
                                   Style="{StaticResource SettingsLabel}"
                                   TextWrapping="Wrap"
                                   Margin="0,16,0,7"/>

                        <TextBox x:Name="NewTabPageBox"
                                 Text="{Binding NewTabPage, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <!-- SERVICES DU HOMELAB -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE968;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="Services du homelab"
                                       Style="{StaticResource SettingsTitle}"
                                       Margin="0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Les services s’ajoutent depuis la page d’accueil ou le menu « Ajouter la page aux services »."
                                   Style="{StaticResource SettingsLabel}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <CheckBox Content="Vérifier régulièrement que les services répondent"
                                  IsChecked="{Binding ServiceMonitoring}"
                                  Margin="0,0,0,10"/>

                        <Grid Margin="24,0,0,10"
                              IsEnabled="{Binding ServiceMonitoring}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fréquence"
                                       Style="{StaticResource SettingsLabel}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <ComboBox x:Name="ServiceIntervalBox"
                                      Grid.Column="1"
                                      Style="{StaticResource DnsComboBoxStyle}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding ServiceCheckIntervalSeconds, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <CheckBox Content="Me prévenir quand un service tombe ou revient"
                                  IsChecked="{Binding ServiceAlerts}"
                                  IsEnabled="{Binding ServiceMonitoring}"
                                  Margin="24,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- DNS -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DNS sécurisé"
                                           Style="{StaticResource SettingsTitle}"
                                           Margin="0"/>
                                <TextBlock Text="Choisissez la résolution DNS utilisée par les onglets WebView2."
                                           Style="{StaticResource SettingsLabel}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Mode"
                                   Style="{StaticResource SettingsLabel}"
                                   Margin="0,0,0,7"/>
                        <ComboBox x:Name="DnsModeBox"
                                  Style="{StaticResource DnsComboBoxStyle}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding DnsMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="DnsSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel x:Name="DnsProviderPanel" Margin="0,14,0,0">
                            <TextBlock Text="Fournisseur"
                                       Style="{StaticResource SettingsLabel}"
                                       Margin="0,0,0,7"/>
                            <ComboBox x:Name="DnsProviderBox"
                                      Style="{StaticResource DnsComboBoxStyle}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding DnsProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="DnsSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="CustomDnsPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="Modèle DNS-over-HTTPS personnalisé"
                                       Style="{StaticResource SettingsLabel}"
                                       Margin="0,0,0,7"/>
                            <TextBox x:Name="CustomDnsTemplateBox"
                                     Text="{Binding SecureDnsCustomTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="CustomDnsTemplateBox_TextChanged"/>
                            <TextBlock Text="Exemple : https://dns.exemple.net/dns-query{?dns}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="2,6,0,0"/>
                            <TextBlock x:Name="CustomDnsValidationText"
                                       FontSize="12"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Margin="2,6,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- État compact, sans encart supplémentaire -->
                        <Grid Margin="2,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text=""
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="14"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,2,0,0"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="DnsStatusText"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Le changement sera appliqué après le redémarrage complet de PommeBrowser."
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CERTIFICATS -->
                <Border Style="{StaticResource SettingsCard}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text=""
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="18"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="Certificats"
                                           Style="{StaticResource SettingsTitle}"
                                           Margin="0"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="Ajoutez des autorités propres au profil PommeBrowser, sans modifier la confiance de Windows, et consultez les magasins système en lecture seule."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="CertificateSummaryText"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Chargement des certificats du profil…"/>
                            <Button Content="Certificats acceptés pour les services locaux…"
                                    Style="{StaticResource TextButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="-8,6,0,0"
                                    Click="OpenPinnedCertificates_Click"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Gérer les certificats"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center"
                                Click="OpenCertificateManager_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
