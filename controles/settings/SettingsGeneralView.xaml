<UserControl x:Class="MyHomelabBrowser.controles.settings.SettingsGeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- CONTENU -->
            <Border Grid.Column="0"
                Background="#1E1E1E"
                CornerRadius="12"
                Padding="28"
                Margin="0,0,24,0">

                <StackPanel>

                    <TextBlock Text="Général"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                    <TextBlock Text="Comportement général du navigateur"
                           Foreground="#A8A8A8"
                           FontSize="14"
                           Margin="0,6,0,28"/>

                    <StackPanel Margin="0,0,0,22">
                        <TextBlock Text="Page de démarrage"
                               Style="{StaticResource SettingsLabel}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                        <TextBox x:Name="StartPageBox"
                             Height="40"
                             Padding="14,0"
                             VerticalContentAlignment="Center"
                             Background="#2B2B2B"
                             Foreground="White"
                             BorderThickness="0"
                             Text="{Binding StartPage}"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Page des nouveaux onglets"
                               Style="{StaticResource SettingsLabel}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                        <TextBox x:Name="NewTabPageBox"
                             Height="40"
                             Padding="14,0"
                             VerticalContentAlignment="Center"
                             Background="#2B2B2B"
                             Foreground="White"
                             BorderThickness="0"
                             Text="{Binding NewTabPage}"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ZONE DE RESPIRATION ASSUMÉE -->
            <Border Grid.Column="1"
                Background="#171717"
                CornerRadius="12"/>
        </Grid>
    </ScrollViewer>

</UserControl>
