<UserControl x:Class="MyHomelabBrowser.controles.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource FluentBg}">

    <UserControl.Resources>

        <Style x:Key="HistoryCtxMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                            <!-- ✅ PAS de layout WPF "menu standard" -> pas de gouttière -->
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="HistoryCtxMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                        CornerRadius="8"
                        Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="Header"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="HistoryCtxSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <!-- pas de sélection -->
            <EventSetter Event="PreviewMouseDown" Handler="HistoryItem_PreviewMouseDown"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="HistoryItem_Click"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder"
                        CornerRadius="12"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                            <ContentPresenter Margin="2"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- ✅ Hover Fluent -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                            </Trigger>

                            <!-- ✅ sélection neutralisée -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="Transparent"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RowBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER TOP ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,16,0">
                <TextBlock Text="Historique"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="CountText"
                           Text="—"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"/>
            </StackPanel>

            <!-- Search -->
            <Border Grid.Column="1"
                    Height="38"
                    CornerRadius="10"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    Padding="12,0"
                    VerticalAlignment="Center">
                <DockPanel LastChildFill="True">

                    <TextBlock Text="🔎"
               Foreground="{StaticResource TextSecondaryBrush}"
               FontSize="14"
               VerticalAlignment="Center"
               Margin="0,0,10,0"/>

                    <!-- ✅ Zone search + clear propre -->
                    <Grid>
                        <TextBox x:Name="SearchBox"
                 Background="Transparent"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 BorderThickness="0"
                 VerticalContentAlignment="Center"
                 FontSize="13"
                 Padding="0,0,34,0"
                 TextChanged="SearchBox_TextChanged"/>

                        <!-- Clear search (overlay à droite) -->
                        <Button x:Name="ClearSearchBtn"
                Content="✕"
                Style="{StaticResource IconButtonStyle}"
                Foreground="{StaticResource TextSecondaryBrush}"
                Click="ClearSearch_Click"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,-6,0"/>
                    </Grid>

                </DockPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Button Content="🧹 Tout effacer"
                        Style="{StaticResource DangerButton}"
                        Click="ClearAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== TOOLBAR ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <CheckBox x:Name="OnlyTodayChk"
                          Content="Afficher seulement aujourd’hui"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"
                          Checked="OnlyTodayChk_Changed"
                          Unchecked="OnlyTodayChk_Changed"/>

               
            </StackPanel>

           
        </Grid>

        <!-- ===== LIST ===== -->
        <ListView x:Name="HistoryList"
                  Grid.Row="2"
                  Background="Transparent"
                  BorderThickness="0"
                  SelectionMode="Extended"
                  SelectionChanged="HistoryList_SelectionChanged"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel">

            <!-- ===== GROUP HEADERS ===== -->
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Margin="0,14,0,6">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,8">

                        <Grid.ContextMenu>
                            <ContextMenu Style="{StaticResource HistoryCtxMenuStyle}">
                                <MenuItem Style="{StaticResource HistoryCtxMenuItemStyle}"
          Click="CtxOpen_Click">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="↗" Foreground="{StaticResource TextPrimaryBrush}" Width="18"/>
                                            <TextBlock Text="Ouvrir"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>

                                <MenuItem Style="{StaticResource HistoryCtxMenuItemStyle}"
          Click="CtxCopyUrl_Click">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⧉" Foreground="{StaticResource TextPrimaryBrush}" Width="18"/>
                                            <TextBlock Text="Copier l’URL"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>

                                <Separator Style="{StaticResource HistoryCtxSeparatorStyle}"/>

                                <MenuItem Style="{StaticResource HistoryCtxMenuItemStyle}"
          Click="CtxDelete_Click">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗑" Foreground="{StaticResource DangerBrush}" Width="18"/>
                                            <TextBlock Text="Supprimer" Foreground="{StaticResource DangerBrush}"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>

                            </ContextMenu>
                        </Grid.ContextMenu>


                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <!-- ✅ date fixe -->
                            <ColumnDefinition Width="36"/>
                            <!-- ✅ delete fixe -->
                        </Grid.ColumnDefinitions>

                        <!-- favicon -->
                        <Border Width="22"
                    Height="22"
                    CornerRadius="6"
                    Background="{StaticResource PanelBrush}"
                    VerticalAlignment="Center">
                            <Image Width="16"
                       Height="16"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Source="{Binding Favicon}"/>
                        </Border>

                        <!-- title + url -->
                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="{Binding Title}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           TextTrimming="CharacterEllipsis"/>

                            <TextBlock Text="{Binding Url}"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.85"/>
                        </StackPanel>

                        <!-- date -->
                        <TextBlock Grid.Column="2"
                       Text="{Binding RelativeDate}"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,8,0"/>

                        <!-- delete -->
                        <Button Grid.Column="3"
                    Content="✕"
                    Foreground="{StaticResource DangerBrush}"
                    Click="Delete_Click"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">

                            <Button.RenderTransform>
                                <TranslateTransform X="6"/>
                            </Button.RenderTransform>

                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>

                                        <!-- ✅ apparait au hover -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsMouseOver}"
                                         Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0"
                                                             Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>

                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="6"
                                                             Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>



        </ListView>
    </Grid>
</UserControl>
