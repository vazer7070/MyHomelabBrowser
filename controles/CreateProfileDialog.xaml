<controles:DialogWindow x:Class="MyHomelabBrowser.controles.CreateProfileDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Title="Créer un profil"
                        Width="420">
    <StackPanel>
        <TextBlock Text="Nom d’utilisateur" Style="{StaticResource DialogHintStyle}" Margin="0,0,0,6"/>
        <TextBox x:Name="UsernameBox" TextChanged="Input_Changed"/>

        <TextBlock Text="Mot de passe" Style="{StaticResource DialogHintStyle}" Margin="0,14,0,6"/>
        <PasswordBox x:Name="PasswordBox" PasswordChanged="Input_Changed"/>
        <TextBlock Text="6 caractères minimum."
                   Style="{StaticResource DialogHintStyle}"
                   FontSize="11.5"
                   Margin="0,4,0,0"/>

        <TextBlock Text="Confirmer le mot de passe" Style="{StaticResource DialogHintStyle}" Margin="0,14,0,6"/>
        <PasswordBox x:Name="ConfirmBox" PasswordChanged="Input_Changed"/>

        <TextBlock x:Name="ErrorText"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Style="{StaticResource DialogButtonBarStyle}">
            <Button Content="Annuler" Command="ApplicationCommands.Close" Margin="0,0,8,0"/>
            <Button x:Name="CreateButton"
                    Content="Créer"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="Create_Click"/>
        </StackPanel>
    </StackPanel>
</controles:DialogWindow>
