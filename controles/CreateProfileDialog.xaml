<Window x:Class="MyHomelabBrowser.controles.CreateProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Créer un profil"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Padding="20"
            Width="360"
            Background="#1E1E1E"
            CornerRadius="12">

        <StackPanel>
            <TextBlock Text="Créer un profil"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <!-- Username -->
            <Grid>
                <TextBox x:Name="UsernameBox"
                         Height="34"
                         Padding="10,6"
                         Background="#262626"
                         Foreground="White"
                         BorderThickness="0"/>

                <TextBlock Text="Nom d’utilisateur"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#9CA3AF"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=UsernameBox}"
                                             Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Password -->
            <PasswordBox x:Name="PasswordBox"
                         Height="34"
                         Padding="10,6"
                         Margin="0,8,0,0"
                         Background="#262626"
                         Foreground="White"
                         BorderThickness="0"/>

            <!-- Confirm -->
            <PasswordBox x:Name="ConfirmBox"
                         Height="34"
                         Padding="10,6"
                         Margin="0,8,0,0"
                         Background="#262626"
                         Foreground="White"
                         BorderThickness="0"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="Annuler"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Click="Cancel_Click"/>
                <Button Content="Créer"
                        Padding="10,6"
                        Click="Create_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
