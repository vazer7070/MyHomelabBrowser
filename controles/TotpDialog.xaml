<controles:DialogWindow x:Class="MyHomelabBrowser.controles.TotpDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Title="Double authentification"
                        Width="440">
    <StackPanel>
        <TextBlock x:Name="AccountText" Style="{StaticResource DialogHintStyle}" Margin="0,0,0,14"/>

        <!-- Code courant -->
        <StackPanel x:Name="CodePanel" Visibility="Collapsed">
            <Border Padding="16,14" CornerRadius="12" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="CodeText"
                                   FontFamily="Consolas"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <ProgressBar x:Name="CountdownBar" Height="4" Margin="0,8,0,0" Maximum="30"/>
                        <TextBlock x:Name="CountdownText" Style="{StaticResource DialogHintStyle}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button x:Name="CopyButton"
                            Grid.Column="1"
                            Content="Copier"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Click="Copy_Click"/>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Changer la clé" Style="{StaticResource TextButtonStyle}" Margin="-8,0,8,0" Click="EditKey_Click"/>
                <Button Content="Retirer" Style="{StaticResource TextButtonStyle}" Foreground="{StaticResource DangerBrush}" Click="Remove_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Saisie de la clé -->
        <StackPanel x:Name="EditPanel" Visibility="Collapsed">
            <TextBlock Text="Collez la clé secrète affichée par le service lors de l’activation de la double authentification (sous le QR code), ou l’adresse otpauth:// contenue dans le QR code."
                       Style="{StaticResource DialogHintStyle}"
                       Margin="0,0,0,8"/>
            <TextBox x:Name="SecretBox" FontFamily="Consolas" TextChanged="SecretBox_TextChanged"/>
            <TextBlock x:Name="ErrorText"
                       Margin="0,8,0,0"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="PreviewText" Style="{StaticResource DialogHintStyle}" Margin="0,8,0,0"/>
            <StackPanel Style="{StaticResource DialogButtonBarStyle}">
                <Button Content="Annuler" Command="ApplicationCommands.Close" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" IsEnabled="False" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="StatusText" Style="{StaticResource DialogHintStyle}" Margin="0,10,0,0" Visibility="Collapsed"/>
    </StackPanel>
</controles:DialogWindow>
