<controles:DialogWindow x:Class="MyHomelabBrowser.controles.VaultDeleteConfirmDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Title="Supprimer cet identifiant ?"
                        Width="460">
    <StackPanel>
        <TextBlock Text="Cette action retire définitivement l’entrée du coffre."
                   Style="{StaticResource DialogHintStyle}"
                   Margin="0,0,0,14"/>

        <Border Padding="14,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Site" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="SiteText"
                           Grid.Column="1"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="1" Text="Utilisateur" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="UsernameText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <StackPanel Style="{StaticResource DialogButtonBarStyle}">
            <Button Content="Annuler" Command="ApplicationCommands.Close" Margin="0,0,8,0"/>
            <Button Content="Supprimer"
                    Style="{StaticResource DangerButtonStyle}"
                    IsDefault="True"
                    Click="Delete_Click"/>
        </StackPanel>
    </StackPanel>
</controles:DialogWindow>
