<controles:DialogWindow x:Class="MyHomelabBrowser.controles.PermissionDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Title="Autorisation demandée"
                        Width="440">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36"
                    CornerRadius="18"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top"
                    Background="{StaticResource AccentSoftBrush}">
                <TextBlock Text="&#xE72E;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="SiteText"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="RequestText"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="RememberBox"
                  IsChecked="True"
                  Margin="50,16,0,0"
                  Content="Retenir ce choix pour ce site"/>

        <StackPanel Style="{StaticResource DialogButtonBarStyle}">
            <Button Content="Bloquer" Command="ApplicationCommands.Close" Margin="0,0,8,0"/>
            <Button Content="Autoriser" Style="{StaticResource PrimaryButtonStyle}" Click="Allow_Click"/>
        </StackPanel>
    </StackPanel>
</controles:DialogWindow>
