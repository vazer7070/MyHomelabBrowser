<controles:DialogWindow x:Class="MyHomelabBrowser.controles.EditFavoriteDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:controles="clr-namespace:MyHomelabBrowser.controles"
                        Title="Modifier le favori"
                        Width="460">
    <StackPanel>
        <!-- Rappel de la page concernée -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="10,8"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="FaviconImage"
                       Width="16" Height="16"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="UrlText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <TextBlock Text="Titre" Style="{StaticResource DialogHintStyle}" Margin="0,0,0,6"/>
        <TextBox x:Name="TitleBox" TextChanged="TitleBox_TextChanged"/>

        <TextBlock Text="Dossier (optionnel)" Style="{StaticResource DialogHintStyle}" Margin="0,14,0,6"/>
        <ComboBox x:Name="FolderBox" IsEditable="True"/>
        <TextBlock Text="Laissez vide pour ranger le favori à la racine de la barre."
                   Style="{StaticResource DialogHintStyle}"
                   FontSize="11.5"
                   Margin="0,4,0,0"/>

        <Grid Margin="0,22,0,0">
            <Button Content="Supprimer"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="Delete_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Command="ApplicationCommands.Close" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton"
                        Content="Enregistrer"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</controles:DialogWindow>
