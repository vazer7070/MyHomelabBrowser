<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests de l'interface de l'édition Avalonia, sans écran (Avalonia.Headless) : le vrai navigateur
    (BrowserApp, MainWindow, pages de PommeBrowser) est ouvert, puis piloté au clavier et à la
    souris. Ses données vont dans un dossier temporaire (HOME et dossiers XDG redirigés) : ces
    tests s'exécutent sous Linux (CI) et macOS. Les pages web, qui demandent le moteur du
    système, ne sont pas ouvertes.
    Avalonia.Headless.XUnit repose sur xunit v3, d'où un projet séparé des tests de la logique.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>PommeBrowser.UiTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\avalonia\PommeBrowser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
