<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests de la logique sans interface. Les fichiers sont liés depuis l'application
    plutôt que référencés : le projet reste en net10.0 et s'exécute sur n'importe quel
    système (l'application, elle, cible net10.0-windows et WPF).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>PommeBrowser.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Même bibliothèque SQLite native que l'application (la version tirée par défaut est vulnérable). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Label="Sources de l'application">
    <Compile Include="..\..\classes\AtomicFile.cs" Link="App\AtomicFile.cs" />
