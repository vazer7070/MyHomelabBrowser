<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Moteur Flash intégré de PommeBrowser : hôte NPAPI hors processus. Il charge le module Flash
		de l'utilisateur (NPSWF64_*.dll, jamais fourni par PommeBrowser), joue le rôle du navigateur
		auprès de lui (flux réseau, scripts, fenêtre) et affiche le contenu dans sa propre fenêtre,
		que PommeBrowser loge dans l'onglet. Un plantage du module n'emporte que ce processus.
		Windows x64 seulement pour l'instant (Flash Player 64 bits) ; publié en NativeAOT.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AssemblyName>PommeFlashHost</AssemblyName>
		<RootNamespace>PommeFlash.Host</RootNamespace>
		<PlatformTarget>x64</PlatformTarget>
		<InvariantGlobalization>true</InvariantGlobalization>
		<SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
		<IsAotCompatible>true</IsAotCompatible>
		<Version>0.1.0</Version>
	</PropertyGroup>

</Project>
