# ─── Discord ───────────────────────────────────────────────────────────────
# Webhook par défaut (Paramètres du salon › Intégrations › Webhooks › Copier l'URL).
DISCORD_WEBHOOK_URL=

# Facultatif : un salon par type de rapport. Sans valeur, le webhook par défaut est utilisé.
DISCORD_WEBHOOK_URL_BUG=
DISCORD_WEBHOOK_URL_MISSING_FEATURE=
DISCORD_WEBHOOK_URL_FEATURE_REQUEST=
DISCORD_WEBHOOK_URL_UI_UX=
DISCORD_WEBHOOK_URL_PERFORMANCE=
DISCORD_WEBHOOK_URL_OTHER=

# ─── Copie des rapports sur disque (volume /data) ──────────────────────────
# Chaque rapport est aussi enregistré dans /data/reports : rien n'est perdu si Discord est en panne.
SUPPORT_STORE_REPORTS=true
# Suppression automatique après N jours (0 : jamais).
SUPPORT_RETENTION_DAYS=90

# ─── Reverse proxy ─────────────────────────────────────────────────────────
# Nombre de reverse proxies devant le serveur (Nginx Proxy Manager, Traefik, Caddy…).
# 0 si le port est exposé directement à Internet (déconseillé).
SUPPORT_PROXY_HOPS=1
# true si le trafic passe par Cloudflare (proxy orange ou tunnel) : l'adresse du
# visiteur est alors lue dans l'en-tête CF-Connecting-IP.
SUPPORT_BEHIND_CLOUDFLARE=false

# ─── Anti-abus ─────────────────────────────────────────────────────────────
# Rapports acceptés par adresse IP sur la fenêtre donnée, et au total par heure.
SUPPORT_REPORTS_PER_ADDRESS=5
SUPPORT_ADDRESS_WINDOW_MINUTES=10
SUPPORT_REPORTS_PER_HOUR=60
