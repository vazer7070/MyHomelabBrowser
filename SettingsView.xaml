<UserControl x:Class="MyHomelabBrowser.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource FluentBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP BAR ================= -->
        <Border Grid.Row="0"
                Background="#1C1C1C"
                BorderBrush="#2A2A2A"
                BorderThickness="0,0,0,1"
                Padding="12">

            <TextBox x:Name="SettingsSearchBox"
                     Height="40"
                     Padding="14,0"
                     VerticalContentAlignment="Center"
                     Background="#2B2B2B"
                     Foreground="White"
                     BorderThickness="0"
                     Text="Rechercher un paramètre…"/>
        </Border>

        <!-- ================= MAIN ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT NAV ================= -->
            <Border Grid.Column="0"
                    Background="#141414"
                    BorderBrush="#2A2A2A"
                    BorderThickness="0,0,1,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
                               Text="Paramètres"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="14,14,14,10"/>

                    <!-- NAV LIST -->
                    <ListBox x:Name="NavList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#CFCFCF"
                             SelectionChanged="NavList_SelectionChanged">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="44"/>
                                <Setter Property="Margin" Value="10,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#D0D0D0"/>
                                <Setter Property="FontSize" Value="14"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    CornerRadius="10"
                                                    Padding="12,0">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background"
                                                            Value="#232323"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd"
                                                            Property="Background"
                                                            Value="#2E2E2E"/>
                                                    <Setter Property="Foreground"
                                                            Value="White"/>
                                                    <Setter Property="FontWeight"
                                                            Value="SemiBold"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd"
                                                            Property="Background"
                                                            Value="#2A2A2A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem Content="Général"/>
                        <ListBoxItem Content="Téléchargements"/>
                        <ListBoxItem Content="Historique"/>
                        <ListBoxItem Content="Mises à jour"/>

                        <!-- separator -->
                        <ListBoxItem IsEnabled="False"
                                     Height="1"
                                     Margin="10,10"
                                     Background="#2A2A2A"/>

                        <ListBoxItem Content="⚠ Avancé"
                                     FontWeight="SemiBold"/>
                    </ListBox>

                    <!-- ================= BOTTOM ZONE ================= -->
                    <Border Grid.Row="2"
                            Background="#111111"
                            BorderBrush="#2A2A2A"
                            BorderThickness="0,1,0,0"
                            Padding="12">

                        <StackPanel>

                            <Button x:Name="ReportIssueBtn"
        Height="56"
        Margin="8,0,8,14"
        Cursor="Hand"
        Click="OpenReportIssue_Click"
        Background="#7A1F1F"
        Foreground="White"
        BorderThickness="0"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="B"
                    Background="{TemplateBinding Background}"
                    CornerRadius="12"
                    Padding="16,10">

                                            <!-- CONTENU DU BOUTON -->
                                            <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                                                <TextBlock Text="🚨 Signaler un problème"
                               FontWeight="SemiBold"
                               FontSize="14"
                               HorizontalAlignment="Center"/>

                                                <TextBlock Text="Bug ou suggestion d’amélioration"
                               FontSize="11"
                               Foreground="#FFDADA"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                                            </StackPanel>

                                        </Border>

                                        <!-- STATES -->
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B"
                            Property="Background"
                            Value="#922828"/>
                                            </Trigger>

                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="B"
                            Property="Background"
                            Value="#5C1414"/>
                                            </Trigger>

                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="B"
                            Property="Opacity"
                            Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>


                            <!-- ACTIONS -->
                            <TextBlock Text="Actions"
                                       Foreground="#AAAAAA"
                                       FontSize="12"
                                       Margin="2,0,0,8"/>

                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="SaveFeedback"
                                           Text="✔ Paramètres enregistrés"
                                           Foreground="#7CFF9B"
                                           FontSize="13"
                                           Opacity="0"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <Button Content="Valider"
                                        Height="40"
                                        Padding="18,0"
                                        FontWeight="SemiBold"
                                        Background="#2A2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="Save_Click"
                                        DockPanel.Dock="Right">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="#343434"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="#1F1F1F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DockPanel>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= CONTENT ================= -->
            <ContentControl Grid.Column="1"
                            Margin="32"
                            x:Name="ContentHost"/>
        </Grid>
    </Grid>
</UserControl>
