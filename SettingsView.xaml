<UserControl x:Class="MyHomelabBrowser.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackgroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SelectionMark"
                                        Width="3"
                                        Height="22"
                                        CornerRadius="2"
                                        Background="{StaticResource AccentBrush}"
                                        Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#31577D"/>
                                <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsNavIconStyle" TargetType="TextBlock">
            <!-- Les glyphes Fluent ont une métrique de ligne différente de Segoe UI. -->
            <!-- Une boîte fixe et un léger décalage vertical évitent l'effet d'icône flottante. -->
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>

        <Style x:Key="SettingsNavLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Paramètres"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Personnalisez le navigateur et ses modules"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Height="40"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕"
                                   FontSize="20"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="SettingsSearchBox"
                                 Grid.Column="1"
                                 MinHeight="0"
                                 Height="38"
                                 Padding="0,4,10,4"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SettingsSearchBox_TextChanged"
                                 KeyDown="SettingsSearchBox_KeyDown"/>
                        <TextBlock x:Name="SettingsSearchPlaceholder"
                                   Grid.Column="1"
                                   Text="Rechercher un paramètre…"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="NavList"
                             Grid.Row="0"
                             Margin="8,14,8,8"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource SettingsNavItemStyle}"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBoxItem Tag="Général">
                            <Grid Height="24" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource SettingsNavIconStyle}"
                                           Text="&#xE80F;"
                                           ToolTip="Général"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource SettingsNavLabelStyle}"
                                           Text="Général"/>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem Tag="Téléchargements">
                            <Grid Height="24" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource SettingsNavIconStyle}"
                                           Text="&#xE896;"
                                           ToolTip="Téléchargements"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource SettingsNavLabelStyle}"
                                           Text="Téléchargements"/>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem Tag="Historique">
                            <Grid Height="24" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource SettingsNavIconStyle}"
                                           Text="&#xE81C;"
                                           ToolTip="Historique"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource SettingsNavLabelStyle}"
                                           Text="Historique"/>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem Tag="Mises à jour">
                            <Grid Height="24" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource SettingsNavIconStyle}"
                                           Text="&#xE895;"
                                           ToolTip="Mises à jour"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource SettingsNavLabelStyle}"
                                           Text="Mises à jour"/>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem Tag="Bloqueur de publicités">
                            <Grid Height="24" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource SettingsNavIconStyle}"
                                           Text="&#xE83D;"
                                           ToolTip="Bloqueur de publicités"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource SettingsNavLabelStyle}"
                                           Text="Bloqueur de publicités"/>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem IsEnabled="False" Height="17" Tag="Séparateur">
                            <Border Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                        </ListBoxItem>

                        <ListBoxItem Tag="⚠ Avancé">
                            <Grid Height="24" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource SettingsNavIconStyle}"
                                           Text="&#xE713;"
                                           ToolTip="Avancé"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource SettingsNavLabelStyle}"
                                           Text="Avancé"/>
                            </Grid>
                        </ListBoxItem>
                    </ListBox>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12">
                        <StackPanel>
                            <Button x:Name="ReportIssueBtn"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Height="44"
                                    Click="OpenReportIssue_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="!" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <TextBlock Text="Signaler un problème" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SaveFeedback"
                                           Text="Paramètres enregistrés"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="12"
                                           Opacity="0"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Enregistrer"
                                        Padding="16,7"
                                        Click="Save_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Section active -->
            <Border Grid.Column="1"
                    Background="{StaticResource WindowBackgroundBrush}">
                <ContentControl x:Name="ContentHost" Margin="30,24,30,30"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
