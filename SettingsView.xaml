<UserControl x:Class="MyHomelabBrowser.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource FluentBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="⚙ Paramètres"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Configuration du navigateur"
                           Foreground="#AAAAAA"/>
            </StackPanel>

            <!-- ================= CONTENT ================= -->
            <StackPanel Grid.Row="1">

                <!-- ===== GENERAL ===== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Général" Style="{StaticResource SettingsTitle}"/>

                        <TextBlock Text="Page de démarrage"
                                   Style="{StaticResource SettingsLabel}"/>
                        <TextBox Height="36"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#2B2B2B"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Text="{Binding StartPage, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Page des nouveaux onglets"
                                   Style="{StaticResource SettingsLabel}"/>
                        <TextBox Height="36"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="#2B2B2B"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Text="{Binding NewTabPage, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="TextBox_TextChanged"/>
                    </StackPanel>
                </Border>

                <!-- ===== SUSPENSION ===== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Suspension des onglets"
                                   Style="{StaticResource SettingsTitle}"/>

                        <CheckBox Content="Activer la suspension automatique"
                                  IsChecked="{Binding EnableSuspension}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Délai (minutes)"
                                       Style="{StaticResource SettingsLabel}"
                                       Width="140"/>
                            <Slider Minimum="1"
                                    Maximum="60"
                                    Value="{Binding SuspendDelayMinutes}"
                                    Width="200"/>
                            <TextBlock Text="{Binding SuspendDelayMinutes}"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== TÉLÉCHARGEMENTS ===== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Téléchargements"
                                   Style="{StaticResource SettingsTitle}"/>

                        <TextBlock Text="Dossier de téléchargement"
                                   Style="{StaticResource SettingsLabel}"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBox Height="36"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     Background="#2B2B2B"
                                     Foreground="#CCCCCC"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     Text="{Binding DownloadFolder}"/>

                            <Button Content="Parcourir…"
                                    Margin="10,0,0,0"
                                    Padding="16,6"
                                    Click="PickDownloadFolder_Click"/>
                        </StackPanel>

                        <TextBlock Text="Les fichiers téléchargés seront enregistrés automatiquement dans ce dossier."
                                   Foreground="#9E9E9E"
                                   FontSize="12"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <!-- ========================= -->
                <!-- FLASH / LEGACY SETTINGS -->
                <!-- ========================= -->

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>

                        <TextBlock Text="Flash / Legacy"
                   Style="{StaticResource SettingsTitle}"/>

                        <CheckBox Content="Activer le support Flash (Ruffle / Legacy)"
                  IsChecked="{Binding EnableFlashSupport}"
                  Margin="0,6"/>

                        <CheckBox Content="Tenter Ruffle avant Basilisk"
                  IsChecked="{Binding PreferRuffle}"
                  IsEnabled="{Binding EnableFlashSupport}"
                  Margin="0,4"/>

                        <CheckBox Content="Mode debug Flash (logs / overlay)"
                  IsChecked="{Binding FlashDebugEnabled}"
                  IsEnabled="{Binding EnableFlashSupport}"
                  Margin="0,4"/>

                        <!-- Basilisk -->
                        <TextBlock Text="Navigateur Legacy (Basilisk)"
                   Style="{StaticResource SettingsLabel}"
                   Margin="0,10,0,4"/>

                        <StackPanel Orientation="Horizontal"
                    IsEnabled="{Binding EnableFlashSupport}">

                            <TextBox Height="36"
                     Width="420"
                     Padding="12,0"
                     VerticalContentAlignment="Center"
                     Background="#2B2B2B"
                     Foreground="#CCCCCC"
                     BorderThickness="0"
                     IsReadOnly="True"
                     Text="{Binding BasiliskPath}"
                     ToolTip="Chemin vers basilisk.exe"/>

                            <Button Content="Parcourir…"
                    Margin="10,0,0,0"
                    Padding="16,6"
                    Click="PickBasiliskPath_Click"/>
                        </StackPanel>

                        <TextBlock Text="Utilisé uniquement si un site nécessite Flash réel (MMO anciens)"
                   Foreground="#9E9E9E"
                   FontSize="12"
                   Margin="0,6,0,0"/>

                        <!-- ===================== -->
                        <!-- WHITELIST LEGACY -->
                        <!-- ===================== -->

                        <Separator Margin="0,16,0,12"/>

                        <TextBlock Text="Sites forcés en mode Legacy"
                   Style="{StaticResource SettingsLabel}"/>

                        <TextBlock Text="Ces sites seront toujours ouverts avec Basilisk, même si Ruffle est disponible."
                   Foreground="#9E9E9E"
                   FontSize="12"
                   Margin="0,0,0,8"/>

                        <ListBox x:Name="FlashLegacyList"
                 Height="120"
                 Background="#2B2B2B"
                 Foreground="#E0E0E0"
                 BorderThickness="0"/>

                        <Button Content="Supprimer le site sélectionné"
                Margin="0,8,0,0"
                Padding="14,6"
                HorizontalAlignment="Left"
                Click="RemoveFlashRule_Click"/>

                    </StackPanel>
                </Border>



                <!-- ===== COMMANDES ===== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Commandes"
                                   Style="{StaticResource SettingsTitle}"/>

                        <CheckBox Content="Activer les commandes"
                                  IsChecked="{Binding EnableCommands}"
                                  Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding Commands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding Enabled}"
                                                  VerticalAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                Background="#2A2A2A"
                                                CornerRadius="6"
                                                Padding="6,2"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Key}"
                                                       FontFamily="Consolas"
                                                       Foreground="#E0E0E0"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Description}"
                                                   Foreground="#BFBFBF"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <!-- ===== HISTORIQUE ===== -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Historique"
                                   Style="{StaticResource SettingsTitle}"/>

                        <TextBlock Text="Consulter et gérer l’historique de navigation"
                                   Foreground="#BFBFBF"
                                   Margin="0,0,0,12"/>

                        <Button Content="📜 Ouvrir l’historique"
                                Padding="16,8"
                                HorizontalAlignment="Left"
                                Click="OpenHistory_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ================= FOOTER ================= -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <TextBlock x:Name="SaveFeedback"
                           Text="✔ Paramètres enregistrés"
                           Foreground="#7CFF9B"
                           FontSize="14"
                           Opacity="0"
                           Margin="0,10,0,0"/>

                <Button Content="Enregistrer"
                        Padding="20,8"
                        Click="Save_Click"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
