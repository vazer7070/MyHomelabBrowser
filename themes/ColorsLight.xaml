<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette PommeBrowser, variante claire (mêmes clés que Colors.xaml).
        Hiérarchie des surfaces, de la plus profonde à la plus haute :
        Chrome (barre d'onglets) < Main (fond) < Surface < Toolbar/Panel < Raised < Hover < Pressed.
        Les noms historiques sont conservés : d'autres vues les référencent.
    -->

    <!-- ===== Couleurs de base ===== -->
    <Color x:Key="ChromeColor">#E6E9EE</Color>
    <Color x:Key="BgMain">#F7F8FA</Color>
    <Color x:Key="BgSecondary">#EEF1F5</Color>
    <Color x:Key="BgTertiary">#E6E9EE</Color>
    <Color x:Key="BgHover">#E1E5EB</Color>
    <Color x:Key="BgPressed">#D4D9E1</Color>
    <Color x:Key="ToolbarColor">#FFFFFF</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#F1F3F6</Color>
    <Color x:Key="AddressBarColor">#EEF1F5</Color>
    <Color x:Key="TabHoverColor">#DADFE6</Color>

    <Color x:Key="Accent">#1A66D9</Color>
    <Color x:Key="AccentStrong">#1F6FEB</Color>
    <Color x:Key="AccentHover">#3B82F6</Color>
    <Color x:Key="AccentSoft">#DCE8FB</Color>

    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="SuccessSoft">#DCF5E6</Color>
    <Color x:Key="Warning">#B26A00</Color>
    <Color x:Key="WarningSoft">#FDF1D8</Color>
    <Color x:Key="Danger">#D1334B</Color>
    <Color x:Key="DangerSoft">#FBE3E7</Color>

    <Color x:Key="TextMain">#1B1F24</Color>
    <Color x:Key="TextMuted">#4B5563</Color>
    <Color x:Key="TextTertiary">#6B7280</Color>

    <Color x:Key="BorderColor">#D9DEE5</Color>
    <Color x:Key="BorderStrongColor">#C3CAD4</Color>

    <!-- Navigation privée : violet -->
    <Color x:Key="PrivateColor">#7C3AED</Color>
    <Color x:Key="PrivateSoftColor">#EDE4FF</Color>
    <Color x:Key="PrivateToolbarColor">#F3EDFF</Color>
    <Color x:Key="PrivateAddressColor">#E9E0FB</Color>

    <Color x:Key="ShadowColor">#000000</Color>

    <!-- ===== Pinceaux ===== -->
    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}"/>
    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource BgMain}"/>
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondary}"/>
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BgMain}"/>
    <SolidColorBrush x:Key="ToolbarBrush" Color="{StaticResource ToolbarColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource BgSecondary}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource BgHover}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource BgPressed}"/>
    <SolidColorBrush x:Key="AddressBarBrush" Color="{StaticResource AddressBarColor}"/>
    <SolidColorBrush x:Key="TabHoverBrush" Color="{StaticResource TabHoverColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentStrong}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoft}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoft}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoft}"/>

    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMain}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextMain}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

    <SolidColorBrush x:Key="PrivateBrush" Color="{StaticResource PrivateColor}"/>
    <SolidColorBrush x:Key="PrivateSoftBrush" Color="{StaticResource PrivateSoftColor}"/>
    <SolidColorBrush x:Key="PrivateToolbarBrush" Color="{StaticResource PrivateToolbarColor}"/>
    <SolidColorBrush x:Key="PrivateAddressBrush" Color="{StaticResource PrivateAddressColor}"/>
    <SolidColorBrush x:Key="PrivateSurfaceBrush" Color="{StaticResource PrivateToolbarColor}"/>
    <SolidColorBrush x:Key="NormalSurfaceBrush" Color="{StaticResource ToolbarColor}"/>

    <!-- Surcharges dynamiques (la fenêtre principale les remplace en navigation privée). -->
    <SolidColorBrush x:Key="SelectedTabBrush" Color="{StaticResource ToolbarColor}"/>
    <SolidColorBrush x:Key="AddressFieldBrush" Color="{StaticResource AddressBarColor}"/>

    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>

    <!-- Police d'icônes : Segoe Fluent Icons (Windows 11), repli MDL2 (Windows 10). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="PopupShadow"
                      BlurRadius="28"
                      ShadowDepth="6"
                      Direction="270"
                      Opacity="0.16"
                      Color="{StaticResource ShadowColor}"/>
</ResourceDictionary>
