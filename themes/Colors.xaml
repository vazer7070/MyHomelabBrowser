<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <Color x:Key="BgMain">#121212</Color>
    <Color x:Key="BgSecondary">#1E1E1E</Color>
    <Color x:Key="BgHover">#2A2A2A</Color>

    <!-- Accent -->
    <Color x:Key="Accent">#4CC2FF</Color>

    <!-- Text -->
    <Color x:Key="TextMain">#FFFFFF</Color>
    <Color x:Key="TextMuted">#A0A0A0</Color>

    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource BgMain}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMain}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="BgHoverBrush"
              Color="{StaticResource BgHover}" />


</ResourceDictionary>
