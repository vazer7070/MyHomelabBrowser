<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Alias historiques, alignés sur la palette de Colors.xaml. -->
    <SolidColorBrush x:Key="FluentBg" Color="{StaticResource BgMain}"/>
    <SolidColorBrush x:Key="FluentSurface" Color="{StaticResource BgSecondary}"/>
    <SolidColorBrush x:Key="FluentHover" Color="{StaticResource BgHover}"/>
    <SolidColorBrush x:Key="FluentAccent" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="FluentText" Color="{StaticResource TextMain}"/>
</ResourceDictionary>
