<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="FluentBg" Color="#202020"/>
        <SolidColorBrush x:Key="FluentSurface" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="FluentHover" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="FluentAccent" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="FluentText" Color="#FFFFFF"/>

        <!-- Fluent TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FluentSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource FluentText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ResourceDictionary>

